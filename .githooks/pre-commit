#!/usr/bin/env python3
"""The repository's pre-commit check. Enable once per clone with
`git config core.hooksPath .githooks`. It refuses a commit that stages a file
over 5 MB, so that run artifacts and other large files go to the backup folder
and not into git's history, or a file whose text looks like a credential: a
GitHub, Anthropic, OpenAI, AWS, DigitalOcean or Matsya token, a private key, or
a password inside a URL. A deliberate exception, after thinking twice:
`git commit --no-verify`. Adapted on 31 October 2026 from the hook of
econ-ark/bellman-ark.
"""
import re
import subprocess
import sys

MAX_BYTES = 5 * 1024 * 1024
SECRETS = {
    "GitHub token": r"\bgh[pousr]_[A-Za-z0-9]{36,}|\bgithub_pat_[A-Za-z0-9_]{22,}",
    "Anthropic key": r"\bsk-ant-(?!test|unit|placeholder)[A-Za-z0-9_-]{20,}",
    "OpenAI key": r"\bsk-proj-[A-Za-z0-9_-]{32,}",
    "AWS key": r"\bAKIA[0-9A-Z]{16}\b",
    "DigitalOcean token": r"\bdop_v1_[a-f0-9]{64}\b",
    "Matsya token": r"\bmsy_(?!0{8})[A-Za-z0-9]{16,}",
    "private key": "-----BEGIN [A-Z ]*PRIVATE " + "KEY-----",
    "password in a URL": r"\b[a-z][a-z0-9+.-]*://([^/\s:@'\"`<]+:[^/\s@'\"`<]+)@",
}
PLACEHOLDERS = {"user:pass", "user:password", "username:password"}


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, check=True).stdout


def main():
    staged = [p for p in git("diff", "--cached", "--name-only", "-z", "--diff-filter=AM").decode().split("\0") if p]
    problems = []
    for path in staged:
        size = int(git("cat-file", "-s", f":{path}"))
        if size > MAX_BYTES:
            problems.append(f"{path}: {size:,} bytes, over the {MAX_BYTES // 2**20} MB cap; large files go to the backup folder")
            continue
        blob = git("cat-file", "blob", f":{path}")
        if b"\0" in blob[:8192]:
            continue
        text = blob.decode("utf-8", "replace")
        for name, pattern in SECRETS.items():
            for match in re.finditer(pattern, text):
                if match.groups() and match.group(1) in PLACEHOLDERS:
                    continue
                line = text.count("\n", 0, match.start()) + 1
                problems.append(f"{path}:{line}: looks like a {name}; a credential never enters git")
    if problems:
        print("pre-commit: refused.", file=sys.stderr)
        for problem in problems:
            print(f"  {problem}", file=sys.stderr)
        print("\n  A deliberate exception, after thinking twice: git commit --no-verify", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
