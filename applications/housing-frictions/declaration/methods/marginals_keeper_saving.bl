@methods: keeper_saving
# The marginal block of the keeper's decision value builder, which states the
# derivatives of the decision value in cash on hand and in housing.

[id=dcsn_marginal, (V[>], c) -> (V) : !dcsn] {
    D_{m_d}V = 𝑢_c(c)                                   :: [id=marginal_cash]
    D_{h_d}V = 𝑢_h(h_d) + β*D_{y_h_kp}V[>]              :: [id=marginal_housing]
}
