@methods: house_choice
# The two marginal blocks of the choice of keeping or adjusting the house, which
# state the derivatives of the decision value as those of the branch the choice
# d selects and the derivatives of the arrival value with the factors of the
# laws of financial assets and housing.

[id=dcsn_marginal, (V_kp[>], V_adj[>], d) : !cntn -> (V) : !dcsn] {
    D_{m_f}V = (D_{w_kp}V_kp[>], D_{w_adj}V_adj[>])[d]  :: [id=marginal_financial]
    D_{m_h}V = (D_{h_kp}V_kp[>], D_{w_adj}V_adj[>])[d]  :: [id=marginal_housing]
}

[id=arvl_marginal, (V) : !dcsn -> (V[<]) : !arvl] {
    D_{y_f}V[<] = E_{η}((1 + r)*D_{m_f}V)               :: [id=marginal_financial]
    D_{y_h}V[<] = E_{η}(D_{m_h}V)                       :: [id=marginal_housing]
}
