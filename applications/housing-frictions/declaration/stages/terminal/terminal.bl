@stage: terminal

# The terminal value of the housing model as a stage. It
# arrives at the financial and housing post-states that the two saving stages
# of the terminal period continue to, under names of its own, so that
# house_choice alone arrives at y_f and y_h. No file of
# applications/housing-frictions/ states a terminal value, and neither does
# §6.2 of Dobrescu and Shanker (2024), which says only "Let T be finite". The
# value written here is the terminal boundary data V[>], zero, supplied at
# realization; its two derivatives are therefore zero, as the marginal block
# of declaration/methods/marginals_terminal.bl states, the agent valuing
# nothing left after the last date T.

[id=arvl_to_dcsn, (y_f_T : ℝ₊, y_h_T : ℝ₊₊) : !arvl -> (y_f_d : ℝ₊, y_h_d : ℝ₊₊) : !dcsn] {
    y_f_d = y_f_T                                       :: [id=financial_assets]
    y_h_d = y_h_T                                       :: [id=housing]
}

# V[>] is the terminal boundary data, zero, supplied at realization
[id=cntn_to_dcsn, (V[>] : ℝ @ !vlu) : !cntn -> (V : ℝ @ !vlu) : !dcsn] {
    V = V[>]                                            :: [id=value]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : ℝ @ !vlu) : !arvl] {
    V[<] = V                                            :: [id=value]
}
