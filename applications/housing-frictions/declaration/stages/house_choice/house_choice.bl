@stage: house_choice

r    : ℝ₊        :: ["rate of return on financial assets"]
W    : ℝ₊₊       :: ["earnings at the age of the period, before the shock"]
η_lo : ℝ₊₊       :: ["the low earnings shock"]
η_hi : ℝ₊₊       :: ["the high earnings shock"]

η : ℝ₊₊
η ~ Mixture((0.5, η_lo), (0.5, η_hi))

[id=arvl_to_dcsn, (y_f : ℝ₊, y_h : ℝ₊₊, η) : !arvl -> (m_f : ℝ₊₊, m_h : ℝ₊₊) : !dcsn] {
    m_f = (1 + r)*y_f + W*η                             :: [id=financial_assets]
    m_h = y_h                                           :: [id=housing]
}

[id=dcsn_to_cntn, (m_f, m_h, d : !ctrl @ {keep, adjust}) : !dcsn -> ()] {
    [label=keep,   () -> (w_kp : ℝ₊₊, h_kp : ℝ₊₊) : !cntn] {
        w_kp = m_f                                      :: [id=cash_on_hand]
        h_kp = m_h                                      :: [id=housing_kept]
    }
    [label=adjust, () -> (w_adj : ℝ₊₊) : !cntn] {
        w_adj = m_f + m_h                               :: [id=total_resources]
    }
}

[id=cntn_to_dcsn, (V_kp[>] : ℝ @ !vlu, V_adj[>] : ℝ @ !vlu, d) : !cntn -> (V : ℝ @ !vlu) : !dcsn] {
    V = (V_kp[>], V_adj[>])[d]                          :: [id=choice_value]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : ℝ @ !vlu) : !arvl] {
    V[<] = E_{η}(V)                                     :: [id=value]
}

[id=policy, (V_kp[>] : ℝ @ !vlu, V_adj[>] : ℝ @ !vlu) : !cntn -> (d : {keep, adjust} @ !ctrl) : !dcsn] {
    d = argmax_{d}(V_kp[>], V_adj[>])                   :: [id=choice]
}
