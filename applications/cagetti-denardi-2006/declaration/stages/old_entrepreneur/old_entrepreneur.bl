@stage: old_entrepreneur

Xa := ℝ₊
Θ  := ℝ₊         :: ["entrepreneurial ability; the nonnegative reals stand in for its two levels, 0 and θ_e"]

σ : ℝ₊₊ \ {1}    :: ["relative risk aversion; the utility formula requires σ different from 1"]
δ : [0,1]        :: ["depreciation rate of capital"]
ν : [0,1]        :: ["degree of decreasing returns of the entrepreneurial technology"]
f : [0,1]        :: ["fraction of working capital an entrepreneur keeps when he defaults"]
r : (-1, inf)    :: ["risk-free interest rate, a price fixed by the stationary equilibrium"]

𝑢(c : ℝ₊₊) := c^(1-σ)/(1-σ)                                        :: [id=util]
Γ(a : ℝ₊, θ : ℝ₊, k : ℝ₊) := (0, (1 - δ)*k + θ*k^ν - (1 + r)*(k - a)]  :: [id=feasible]

[id=arvl_to_dcsn, (a_oe : Xa, θ_oe : Θ) : !arvl -> (a : Xa, θ : Θ) : !dcsn] {
    a = a_oe
    θ = θ_oe
}

[id=dcsn_to_cntn, (a, θ, k : ℝ₊ @ !ctrl, c : ℝ₊₊ @ !ctrl, d : !ctrl @ {repay, default}) : !dcsn -> ()] {
    [label=repay, () -> (a_oe_ed : Xa, θ_oe_ed : Θ) : !cntn] {
        a_oe_ed = (1 - δ)*k + θ*k^ν - (1 + r)*(k - a) - c       :: [id=budget]
        θ_oe_ed = θ
    }
    [label=default, () -> (a_oe_rt : Xa) : !cntn] {
        a_oe_rt = f*k                                          :: [id=kept_capital]
    }
}

[id=cntn_to_dcsn, (V_repay[>] : ℝ @ !vlu, W_r[>] : ℝ @ !vlu, c, d) : !cntn -> (V : ℝ @ !vlu) : !dcsn] {
    V = (𝑢(c) + V_repay[>], W_r[>])[d]                         :: [id=value]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : ℝ @ !vlu) : !arvl] {
    V[<] = V                                                  :: [id=value]
}

[id=policy, (V_repay[>] : ℝ @ !vlu, W_r[>] : ℝ @ !vlu) : !cntn -> (k : ℝ₊ @ !ctrl, c : ℝ₊₊ @ !ctrl, d : {repay, default} @ !ctrl) : !dcsn] {
    (k, c) = argmax_{k, c : Γ(a, θ, k)}(𝑢(c) + V_repay[>])      :: [id=optimality]
    𝑢(c) + V_repay[>] >= W_r[>]                                 :: [id=enforcement]
    d = argmax_{d}(𝑢(c) + V_repay[>], W_r[>])                   :: [id=repayment]
}
