@methods: entrepreneur_ageing
# The methods of the stage entrepreneur_ageing as an addition to
# entrepreneur_ageing.bl: the exact sum over the new draws of the two
# abilities in the arrival expectation, the sum over remaining young and
# ageing in the decision value, a histogram on the asset grid for the measure
# the arrival builder pushes forward, and the deterministic transition of the
# decision builder,
# which branches over the shock s. No method adds a line, and a block body may
# not be empty, so every selection is a file-level line routed by its path
# (rule 7); the two expectations are the groups E_y_n_θ_n.method and
# E_s.method of the blocks that hold them, written at file level with the
# block id as the first segment.

n_a : ℕ        :: ["number of points of the asset grid"]
a_min : Xa     :: ["lowest point of the asset grid, the borrowing limit"]
a_max : Xa     :: ["highest point of the asset grid"]

dcsn_to_arvl.E_y_n_θ_n.method : !exact_markov    # no form in §4: on: E_y_n_θ_n, the stage-wide address, method: !exact-markov
cntn_to_dcsn.E_s.method : !sum    # no form in §4: on: E_s, the stage-wide address, method: !sum
arvl_to_dcsn.method : !histogram
arvl_to_dcsn.grid : !Cartesian(a=(a_min, a_max, n_a))    # no form in §4: orders: [n_a], bounds: [[a_min, a_max]], no coordinate named; the coordinate a of the codomain of arvl_to_dcsn, and no factor for y and θ
dcsn_to_cntn.method : !deterministic    # no form in §4: on: dcsn_to_cntn, method: !deterministic, the method slot of a block whose body is two labeled branches
