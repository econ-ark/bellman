@methods: consumption_choice
# The method block of the owner's consumption policy builder, the endogenous
# grid method, whose candidate line reads the derivative of the continuation
# value in savings by the term D_{a_nxt}V[>].

[id=egm, (V[>] : ℝ @ !vlu) : !cntn -> (c : ℝ₊ @ !ctrl) : !dcsn] {
    c[>] = (β*D_{a_nxt}V[>] / (θ * (κ*H_c + ι)^((1-θ)*(1-γ))))^(1/(θ*(1-γ) - 1))  :: [id=InvEuler, !node]
    w[>] = a_nxt + c[>]                                                             :: [id=regrid, !node]
    c    = c[>]                                                                     :: [id=cons_choice]
}
