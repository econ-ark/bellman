@methods: retiree_saving
# The two marginal blocks of the retiree's saving stage, which state the
# derivative of the decision value in resources, the envelope condition, and the
# derivatives of the arrival value with the factors of the law of resources.

[id=dcsn_marginal, (c) : !cntn -> (V) : !dcsn] {
    D_{m_r}V = 𝑑𝑢(c)                                  :: [id=marginal]
}

[id=arvl_marginal, (V) : !dcsn -> (V[<]) : !arvl] {
    D_{y_f_r}V[<] = (1 + r_f)*D_{m_r}V                :: [id=marginal_financial]
    D_{y_p_r}V[<] = (1 + r_p)*D_{m_r}V                :: [id=marginal_pension]
}
