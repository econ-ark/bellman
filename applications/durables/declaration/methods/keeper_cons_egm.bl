@methods: keeper_cons
# The method block of the keeper's policy builder, the endogenous grid method,
# whose candidate line reads the derivative of the continuation value in
# savings by the term D_{a_nxt_kp}V[>].

[id=egm, (V[>] : ℝ @ !vlu) : !cntn -> (c : ℝ₊₊ @ !ctrl) : !dcsn] {
    c[>]   <= 𝑢_c_inv(β*D_{a_nxt_kp}V[>])              :: [id=InvEuler]
    w_d[>] = a_nxt_kp + c[>]                          :: [id=endoggrid]
    c      = c[>]                                     :: [id=cons_choice]
}
