@methods: bequest
# The two marginal blocks of the bequest, which state in closed form the
# derivative of the terminal value in wealth and the derivatives of the
# arrival value, each with the factor of the law x = R*a_bq + R_H*(1 - δ)*h_bq.

[id=dcsn_marginal, () -> (V) : !dcsn] {
    D_{x}V = θ*α*(K + x)^(-γ_c)                        :: [id=marginal_wealth]
}

[id=arvl_marginal, (V) : !dcsn -> (V[<]) : !arvl] {
    D_{a_bq}V[<] = R*D_{x}V                            :: [id=marginal_assets]
    D_{h_bq}V[<] = R_H*(1 - δ)*D_{x}V                  :: [id=marginal_housing]
}
