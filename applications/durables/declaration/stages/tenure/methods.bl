@methods: tenure
# The methods of the tenure stage as an addition to tenure.bl: the discrete
# maximum over keeping and adjusting on the policy builder, realized by the
# routine make_tenure_ops of the replication code, with the rule at a tie as a
# setting valued in the control's own set; the two derivative lines of the
# decision value from the former block file marginals_tenure.bl; the linear
# representation of the
# decision value on the grid of assets and housing, named at the value's
# Evaluation, the one place the YAML names; Tauchen's chain at the expectation
# over the innovation to log income, in place of the declared normal law; and
# the Monte Carlo draw of the innovation on the arrival edge. The stage branches
# dcsn_to_cntn over d; no entry names a branch, so the addition writes no nested
# block. The policy builder, the arrival value builder and the arrival builder
# gain no line, so their selections are file-level lines routed by their paths;
# the expectation is named by the path through the line value. The grid of the
# value's Evaluation is its grid entry, one factor per coordinate (D5, writer's
# sheet §7).

tie_break : {keep, adjust}                :: ["branch chosen when the values of keeping and adjusting are equal"]
n_a : ℕ                                   :: ["number of points of the asset grid"]
a_min : ℝ₊                                :: ["lower bound of the asset grid"]
a_max : ℝ₊                                :: ["upper bound of the asset grid"]
n_h : ℕ                                   :: ["number of points of the housing grid"]
h_min : ℝ₊₊                               :: ["lower bound of the housing grid"]
h_max : ℝ₊₊                               :: ["upper bound of the housing grid"]
extrap_policy : {0, 1}                    :: ["zero clamps a tabulated function at the boundary, one extrapolates linearly"]
clamp_max_factor : ℝ₊₊                    :: ["bound on a policy read above the grid, as a factor of the grid's upper end"]
N_wage : ℕ                                :: ["number of states of Tauchen's chain for the income state"]
tauchen_n_std : ℝ₊₊                       :: ["number of unconditional standard deviations the chain spans"]
tauchen_min_prob : (0,1)                  :: ["floor on the transition probabilities of the chain"]
n_sim : ℕ                                 :: ["number of simulated households"]
sim_seed : ℕ                              :: ["seed of the simulation"]

policy.method : !max(tie_break=tie_break)    # no form in §4: handler: fues-durables:make_tenure_ops; tie_break, a setting beyond the catalogue row
policy.handler : "fues-durables:make_tenure_ops"

[id=cntn_to_dcsn
    | evaluate[V].method : !Linear(extrapolate=extrap_policy, clamp_factor=clamp_max_factor)
    | evaluate[V].handler : "dcsmm:interp_as_scalar"
    | evaluate[V].grid : !Cartesian(a_d=(a_min, a_max, n_a), h_d=(h_min, h_max, n_h))] {    # no form in §4: handler: dcsmm:interp_as_scalar; extrapolate and clamp_factor, settings beyond the catalogue row
    D_{a_d}V = (R*D_{w_kp}V_kp[>], R*D_{w_adj}V_adj[>])[d]                          :: [id=marginal_assets]
    D_{h_d}V = ((1 - δ)*D_{h_kp}V_kp[>], R_H*(1 - δ)*D_{w_adj}V_adj[>])[d]          :: [id=marginal_housing]
}

dcsn_to_arvl.value.E_ε.method : !tauchen(n_income_states=N_wage, n_std=tauchen_n_std, min_prob=tauchen_min_prob)    # no form in §4: on: E_ε, the stage-wide address; !tauchen replacing the declared normal law of ε by a finite chain, D6 and F15; handler: fues-durables:make_conditioners
dcsn_to_arvl.value.E_ε.handler : "fues-durables:make_conditioners"
arvl_to_dcsn.method : !monte_carlo(n_paths=n_sim, seed=sim_seed)    # no form in §4: handler: fues-durables:make_tenure_forward
arvl_to_dcsn.handler : "fues-durables:make_tenure_forward"
