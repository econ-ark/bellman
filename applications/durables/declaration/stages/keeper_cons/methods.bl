@methods: keeper_cons
# The methods of the keeper's consumption stage as an addition to
# keeper_cons.bl: the endogenous grid method on the policy builder, realized by
# the routine make_keeper_ops of the replication code, on the savings grid,
# with the fifteen further settings the routine reads; the two candidate lines
# of the former block file keeper_cons_egm.bl, the inverted Euler equation and the endogenous grid of
# cash on hand; the two derivative lines of the decision value from the
# former block file marginals_keeper_cons.bl; and the linear representation of the decision value
# and of its two stated derivatives on the grid of cash on hand and housing.
# The three lines of keeper_cons_egm.bl are written as the block file wrote
# them, the identification line cons_choice, c = c[>], included: with !egm in
# the slot they stand in place of the maximization at the operative level, and
# stage.declared keeps the maximization (proposal §4 rule 5, D8). The two YAML
# entries on the value and on the marginal Evaluation carry equal settings and
# the marginal Evaluation holds two derivatives, so one unrefined entry
# represents the value and both derivatives. Each grid is the
# grid entry of its place, one factor per coordinate (D5, writer's sheet §7):
# savings for the method, cash on hand and housing for the Evaluation, the
# factor of cash on hand reading the settings of the savings grid, since
# settings/durables.yml makes the one grid serve both.

n_a : ℕ                                   :: ["number of points of the savings grid"]
a_min : ℝ₊₊                               :: ["lower bound of the savings grid and of the grid of cash on hand"]
a_max : ℝ₊₊                               :: ["upper bound of the savings grid and of the grid of cash on hand"]
n_h : ℕ                                   :: ["number of points of the housing grid"]
h_min : ℝ₊₊                               :: ["lower bound of the housing grid"]
h_max : ℝ₊₊                               :: ["upper bound of the housing grid"]
grid_phi : ℝ₊₊                            :: ["exponent of the spacing of the savings grid, above one packing points near the lower end"]
b : ℝ₊                                    :: ["lowest saving the method uses and the floor to which savings are clamped"]
keeper_upper_envelope : {FUES, DCEGM, RFC, CONSAV}    :: ["upper envelope method of the keeper's endogenous grid method"]
m_bar : ℝ₊₊                               :: ["jump threshold of the upper envelope scan"]
fues_lb : ℕ                               :: ["number of points the upper envelope scan looks back"]
fues_eps_d : ℝ₊₊                          :: ["tolerance of the scan on the difference of gradients"]
fues_eps_sep : ℝ₊₊                        :: ["tolerance of the scan on the separation of points"]
fues_eps_fwd_back : ℝ₊₊                   :: ["proximity of the forward and backward scans"]
fues_parallel_guard : ℝ₊₊                 :: ["guard of the scan against parallel segments"]
keeper_include_intersections : {0, 1}     :: ["one adds the intersection points of the envelope"]
keeper_no_double_jumps : {0, 1}           :: ["one forbids two jumps in a row"]
keeper_single_intersection : {0, 1}       :: ["one keeps a single intersection at each jump"]
keeper_disable_jump_checks : {0, 1}       :: ["one disables the checks of the jumps"]
extrap_policy : {0, 1}                    :: ["zero clamps a tabulated function at the boundary, one extrapolates linearly"]
clamp_max_factor : ℝ₊₊                    :: ["bound on a policy read above the grid, as a factor of the grid's upper end"]

[id=policy, policy.method : !egm(spacing=grid_phi, savings_floor=b,
        upper_envelope=keeper_upper_envelope, jump_threshold=m_bar,
        lookback=fues_lb, eps_d=fues_eps_d, eps_sep=fues_eps_sep,
        eps_fwd_back=fues_eps_fwd_back, parallel_guard=fues_parallel_guard,
        include_intersections=keeper_include_intersections,
        no_double_jumps=keeper_no_double_jumps,
        single_intersection=keeper_single_intersection,
        disable_jump_checks=keeper_disable_jump_checks)
    | policy.handler : "fues-durables:make_keeper_ops"
    | policy.grid : !Cartesian(a_nxt_kp=(a_min, a_max, n_a))] {    # no form in §4: handler: fues-durables:make_keeper_ops; thirteen settings of the handler beyond the catalogue row; savings_spacing: grid_phi, the exponent of an uneven spacing, which no spacing word of the sheet's §7 carries; savings_orders: [n_a] and savings_bounds: [[a_min, a_max]], the handler's restatement of the grid in the positional list form, written as nothing since the grid entry carries it
    c[>]   <= 𝑢_c_inv(β*D_{a_nxt_kp}V[>])              :: [id=InvEuler]
    w_d[>] = a_nxt_kp + c[>]                          :: [id=endoggrid]
    c      = c[>]                                     :: [id=cons_choice]
}

[id=cntn_to_dcsn
    | evaluate.method : !Linear(extrapolate=extrap_policy, clamp_factor=clamp_max_factor)
    | evaluate.handler : "dcsmm:interp_as"
    | evaluate.grid : !Cartesian(w_d=(a_min, a_max, n_a), h_d=(h_min, h_max, n_h))] {    # no form in §4: handler: dcsmm:interp_as; extrapolate and clamp_factor, settings beyond the catalogue row; the two entries on cntn_to_dcsn.evaluate.value and cntn_to_dcsn.evaluate.marginal, with equal settings
    D_{w_d}V = 𝑢_c(c)                                  :: [id=marginal_cash]
    D_{h_d}V = 𝑢_h(h_d) + β*D_{h_nxt_kp}V[>]           :: [id=marginal_housing]
}
