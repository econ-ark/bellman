@stage: bequest

Age := {20, …, 71}

θ   : ℝ₊₊         :: ["weight of the bequest in utility"]
K   : ℝ₊₊         :: ["shift of the bequest utility"]
α   : (0,1)       :: ["weight of consumption in utility"]
γ_c : (1, inf)    :: ["curvature of utility from consumption"]
R   : ℝ₊₊         :: ["gross return on financial assets"]
R_H : ℝ₊₊         :: ["gross return on housing, received when the house is sold"]
δ   : [0,1)       :: ["depreciation rate of housing"]

[id=arvl_to_dcsn, (a_bq : ℝ₊, h_bq : ℝ₊₊, z_bq : ℝ₊₊) : !arvl -> (x : ℝ₊₊) : !dcsn] {
    x = R*a_bq + R_H*(1 - δ)*h_bq                      :: [id=wealth]
}

# The user supplies age 71 and the zero continuation value V[>] at realization.
[id=cntn_to_dcsn, (V[>] : ℝ @ !vlu, age : Age @ !vlu @ !cnst) : !cntn -> (V : ℝ @ !vlu, age) : !dcsn] {
    V = θ*α*(K + x)^(1-γ_c)/(1-γ_c) + V[>]             :: [id=value]
}

[id=dcsn_to_arvl, (V, age) : !dcsn -> (V[<] : ℝ @ !vlu, age) : !arvl] {
    V[<] = V                                           :: [id=value]
}
