@methods: bequest
# The methods of the terminal stage `bequest`, whose stage file is bequest.bl
# beside this file, written as an addition to that file: the derivative of
# the warm-glow bequest in wealth, in closed form, appended to the decision
# value builder. The block names the stage's block by its id and adds no
# coordinate, so it carries no signature.

[id=cntn_to_dcsn] {
    D_{a}V = (A/β)*a^(-μ)                    :: [id=marginal]
}
