@methods: bellman
# The methods of the within-life stage `bellman`, whose stage file is
# benhabib_bellman.bl beside this file, written as an addition to that file: a
# block below names a block of the stage by its id and adds its entries and
# its lines to it. The block `policy` types the policy builder with the
# endogenous grid method, with the legacy's placeholder handler, which no
# callable realizes yet, and with its grid of savings, and writes the two
# candidate lines of the method, the inverted Euler equation and the inverted
# law of motion, each marked !node, and the identification c = c[>]; with the
# solution method on the builder these lines stand in place of the stage
# file's maximization at the operative level, and the declared level keeps
# the maximization. The block `cntn_to_dcsn` appends the envelope line of the
# decision value builder. The three settings the grid reads are declared
# with their sets, the bounds as points of Xa, the set of the savings a, and
# the count in ℕ; their values stay in settings/default.yml.

n_a : ℕ        :: ["number of points of the savings grid"]
a_min : Xa     :: ["lower bound of the savings grid"]
a_max : Xa     :: ["upper bound of the savings grid"]

[id=policy, method : !egm | handler : "dolo:egm_backward"
    | grid : !Cartesian(a=(a_min, a_max, n_a))] {
    c[>] = (β * R_vec[r_type] * D_{a}V[>])^(-1/σ)        :: [id=InvEuler, !node]
    m[>] = c[>] + (a - wage_fn[tau]) / R_vec[r_type]     :: [id=inv_g_dcsn_to_cntn, !node]
    c    = c[>]                                          :: [id=cons_choice]
}

[id=cntn_to_dcsn] {
    D_{m}V = c^(-σ)                    :: [id=marginal]
}
