@methods: owner_cons
# The derivative of the owner's consumption value in cash on hand, stated as
# the marginal block of the decision value builder (AMD-MB-001 §4.3): the
# envelope condition.

[id=dcsn_marginal, (c) : !cntn -> (V) : !dcsn] {
    D_{w_d}V = 𝑑𝑢(c)                 :: [id=marginal]
}
