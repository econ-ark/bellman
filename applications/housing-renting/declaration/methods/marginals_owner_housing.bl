@methods: owner_housing
# The derivative of the owner's housing value in assets, stated as the
# marginal block of the decision value builder (AMD-MB-001 §4.3): the
# derivative of the continuation value in cash times the derivative of the
# owner's budget in assets.

[id=dcsn_marginal, (V[>]) : !cntn -> (V) : !dcsn] {
    D_{a_d}V = (1 + r - 𝑑𝑇(a_d))*D_{w_own}V[>]    :: [id=marginal, "the derivative with respect to the assets a_d, which enter cash after tax"]
}
