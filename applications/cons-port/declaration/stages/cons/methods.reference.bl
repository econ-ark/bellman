@methods: cons
# The methods of methods.bl at the consumption occurrences of the fixed
# reference's trellis files, trellis.reference-cons-only.yml,
# trellis.reference-cons-port.yml and trellis.reference-port-cons.yml, whose
# settings file settings/cons.yml values evenly spaced grids, as the reference
# computed them: the endogenous grid method on the policy builder, realized by
# the function egm of code/cons_port_tool.py, with its three lines; the
# envelope line of the decision value; and the linear representation of that
# value and of its stated derivative on the grid of resources. The two grids
# carry no spacing word, so their points are evenly spaced.

𝑑𝑢(c : ℝ₊₊) := c^(-ρ)
𝑑𝑢𝑖𝑛𝑣(x : ℝ₊₊) := x^(-1/ρ)

n_a : ℕ              :: ["number of points of the savings grid"]
a_min : Xa           :: ["lower bound of the savings grid"]
a_max : Xa           :: ["upper bound of the savings grid"]
n_m : ℕ              :: ["number of points of the grid of resources"]
m_min : Xm           :: ["lower bound of the grid of resources"]
m_max : Xm           :: ["upper bound of the grid of resources"]

[id=policy, method : !egm,
    (V[>] : ℝ @ !vlu) : !cntn -> (c : ℝ₊₊ @ !ctrl) : !dcsn
    | handler : "cons-port:egm"
    | grid : !Cartesian(a=(a_min, a_max, n_a))] {
    c[>] <= 𝑑𝑢𝑖𝑛𝑣(D_{a}V[>]) ⟂ a >= 0      :: [id=InvEuler]
    m[>] = a + c[>]                          :: [id=grid]
    c = c[>]                                 :: [id=identification]
}

[id=cntn_to_dcsn
    | evaluate.method : !Linear
    | evaluate.grid : !Cartesian(m=(m_min, m_max, n_m))] {
    D_{m}V = 𝑑𝑢(c)                           :: [id=envelope]
}
