@methods: cons_savings_iid
# The endogenous grid method as the method block of the policy builder, whose
# stage file states the maximization alone (AMD-MB-001 §4.1). The candidate
# line reads the derivative of the continuation value by the term D_{a}V[>].

[id=egm, (V[>] : ℝ @ !vlu) : !cntn -> (c : ℝ₊₊ @ !ctrl) : !dcsn] {
    c[>] = 𝑑𝑢𝑖𝑛𝑣(β*D_{a}V[>])       :: [id=InvEuler]
    w[>] = a + c[>]                 :: [id=g_cntn_to_dcsn]
    c[~] = c[>]                     :: [id=cons_choice]
}
