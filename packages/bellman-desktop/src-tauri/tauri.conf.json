{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bellman Workbench",
  "version": "0.1.0",
  "identifier": "org.econark.bellman-workbench",
  "build": {
    "frontendDist": "../assets"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Read Bellman models beside their source files",
    "fileAssociations": [
      {
        "ext": [
          "bl"
        ],
        "name": "Bellman stage",
        "role": "Editor",
        "mimeType": "text/x-bellman"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "bellman"
        ]
      }
    }
  }
}
