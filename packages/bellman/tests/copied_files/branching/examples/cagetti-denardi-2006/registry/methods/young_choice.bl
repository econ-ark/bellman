@methods: young_choice
# The methods of the stage young_choice as an addition to young_choice.bl: the
# discrete maximum over running a business and working (equation (2) of the
# paper) on the policy builder, the identity for the measure that
# `arvl_to_dcsn` carries to the decision perch, and the deterministic
# transition of the forward decision builder `dcsn_to_cntn`, which branches
# over the control d. No method adds a line, so each entry is at file level.
# The forward builders are written first: the package attaches each line at
# file level by its path, so the order of the lines is immaterial.

arvl_to_dcsn.method : !identity
dcsn_to_cntn.method : !deterministic        # the method of a block whose body is two branches with labels
policy.method : !max
