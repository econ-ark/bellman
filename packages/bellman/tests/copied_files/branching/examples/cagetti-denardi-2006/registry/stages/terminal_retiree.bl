@stage: terminal_retiree

# The continuation value of a retiree at the end of the terminal year, the
# terminal period periods[0]; in every other year the next year's
# retiree_death supplies it. The arrival field carries the tag tr and is
# reached from retiree's a_rt_rd by the connector of the terminal period's own
# entry of trellis.yml.

Xa := ℝ₊

[id=arvl_to_dcsn, (a_tr : Xa) : !arvl -> (a : Xa) : !dcsn] {
    a = a_tr
}

# V[>] is the terminal boundary data, zero, supplied at realization
[id=cntn_to_dcsn, (V[>] : ℝ @ !vlu) -> (V : ℝ @ !vlu) : !dcsn] {
    V = V[>]                             :: [id=value]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : ℝ @ !vlu) : !arvl] {
    V[<] = V                             :: [id=value]
}
