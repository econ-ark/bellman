@methods: young_entrepreneur
# The methods of the stage young_entrepreneur as an addition to
# young_entrepreneur.bl: value function iteration for the decision value on
# a grid of assets and capital (Appendix B of the paper), the identity for
# the measure that `arvl_to_dcsn` carries to the decision perch, and a
# histogram for the measure that the forward decision builder `dcsn_to_cntn`
# pushes forward through its two branches, on the asset coordinate of each
# branch. Each grid is a grid entry, with one factor for each coordinate. No
# method adds a line, so every entry is a line at file level, which the
# package attaches to the block that the first segment of its path names. The
# iteration on the largest enforceable capital, which imposes the line
# enforcement of the policy builder, has no entry here, since it names no
# method word; its tolerance tol_k is declared below with the other settings,
# whose values, apart from that of k_min, stand in settings/cagetti_denardi.yml.
# The package refuses the stage file (`not-constructed`, at its branching
# block dcsn_to_cntn), with this file read into it as without it, so no path
# below is checked against the places of this stage.

n_a : ℕ        :: ["number of points of the asset grid"]
a_min : Xa     :: ["lowest point of the asset grid, the borrowing limit"]
a_max : Xa     :: ["highest point of the asset grid"]
n_k : ℕ        :: ["number of points of the capital grid"]
k_min : ℝ₊     :: ["lowest point of the capital grid, the number 0 in the YAML; the settings file has no key for it"]
k_max : ℝ₊     :: ["highest point of the capital grid, and the first value of the bound on enforceable capital"]
tol_v : ℝ₊₊    :: ["tolerance of value function iteration"]
tol_k : ℝ₊₊    :: ["tolerance of the iteration on the bound on enforceable capital"]

cntn_to_dcsn.method : !vfi(tol=tol_v)
cntn_to_dcsn.grid : !Cartesian(a=(a_min, a_max, n_a), k=(k_min, k_max, n_k))        # a is a state of the decision perch and k a control, neither in the header of cntn_to_dcsn; the lower bound of k is the setting k_min
arvl_to_dcsn.method : !identity
dcsn_to_cntn.method : !histogram        # the method of a block whose body is two branches with labels
dcsn_to_cntn.repay.grid : !Cartesian(a_ye_ea=(a_min, a_max, n_a))        # the asset coordinate differs by branch, so each branch takes a grid entry of its own, the label a segment of the path
dcsn_to_cntn.default.grid : !Cartesian(a_ye_wk=(a_min, a_max, n_a))
