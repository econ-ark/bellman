@stage: retiree_death

Xa := ℝ₊
Y  := ℝ₊₊        :: ["working ability; the positive reals stand in for its finite grid, whose number of points is a numerical choice"]
Θ  := ℝ₊         :: ["entrepreneurial ability; the nonnegative reals stand in for its two levels, 0 and θ_e"]

β      : (0,1)   :: ["discount factor"]
η      : [0,1]   :: ["weight on the utility of the descendants"]
π_o    : [0,1]   :: ["probability that an old person survives for another period"]
P_y    : [0,1]   :: ["transition matrix of working ability; the set of one probability stands in for the matrix"]
y_grid : ℝ₊₊     :: ["grid points of working ability, normalised to an average of one; the positive reals stand in for the vector"]
ρ_θ0   : [0,1]   :: ["probability that zero entrepreneurial ability persists"]
ρ_θ1   : [0,1]   :: ["probability that the positive entrepreneurial ability persists"]
θ_e    : ℝ₊₊     :: ["the positive level of entrepreneurial ability"]

y_n : Y
y_n ~ Invariant(P_y, y_grid)                                                :: ["the working ability of an offspring, drawn from the invariant distribution of P_y"]
θ_n : Θ
θ_n ~ Invariant(((ρ_θ0, 1 - ρ_θ0), (1 - ρ_θ1, ρ_θ1)), (0, θ_e))             :: ["the entrepreneurial ability of an offspring, drawn from the invariant distribution of the ability chain"]
s : {survive, die}
s ~ Categorical((π_o, 1 - π_o))                                             :: ["surviving or dying, with probabilities in the order of the labels"]

[id=arvl_to_dcsn, (a_rd : Xa, y_n, θ_n) : !arvl -> (a : Xa, y : Y, θ : Θ) : !dcsn] {
    a = a_rd
    y = y_n
    θ = θ_n
}

[id=dcsn_to_cntn, (a, y, θ, s) : !dcsn -> ()] {
    [label=survive, () -> (a_rd_rt : Xa) : !cntn] {
        a_rd_rt = a
    }
    [label=die, () -> (a_rd_yc : Xa, y_rd_yc : Y, θ_rd_yc : Θ) : !cntn] {
        a_rd_yc = a
        y_rd_yc = y
        θ_rd_yc = θ
    }
}

[id=cntn_to_dcsn, (W_r[>] : ℝ @ !vlu, V_young[>] : ℝ @ !vlu) : !cntn -> (V : ℝ @ !vlu) : !dcsn] {
    V = β*E_{s}((W_r[>], η*V_young[>])[s])       :: [id=value]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : ℝ @ !vlu) : !arvl] {
    V[<] = E_{y_n,θ_n}(V)                        :: [id=value]
}
