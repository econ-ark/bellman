@stage: plan_choice

# The once-only irrevocable choice of plan type at the enrolment age t_0
# (Dobrescu, Fan, Bateman, Newell, Ortmann and Thorp, equations 5, 16 and 17).
# Nothing about the individual's wealth changes here; the choice fixes which
# of the two routes the rest of the life cycle follows.

σ_p  : ℝ₊₊   :: ["scale of the plan taste shocks ζ_DB and ζ_DC, which are type I extreme value (equation 17)"]
ψ    : ℝ₊    :: ["the individual's default-preference type, ψ_H or ψ_L, each drawn with probability one half (section 3.3)"]
ν_p0 : ℝ     :: ["constant of the plan switching cost (equation 5)"]
ν_p1 : ℝ     :: ["age coefficient of the plan switching cost"]
ν_p2 : ℝ     :: ["squared-age coefficient of the plan switching cost"]
t_0  : ℝ₊₊   :: ["enrolment age; this stage occurs only in the period whose age is t_0"]

𝑢p(x : ℝ₊₊) := ψ + exp(ν_p0 + ν_p1*x + ν_p2*x^2)                  :: [id=plan_cost, "the utility cost of leaving the default DB plan, equation 5"]
𝑙𝑠𝑢𝑚2(x : ℝ, y : ℝ, σ : ℝ₊₊) := σ*log(exp(x/σ) + exp(y/σ))        :: [id=logsum, "the expected maximum of two alternatives under type I extreme value taste shocks of scale σ"]
𝑝𝑟𝑜𝑏2(x : ℝ, y : ℝ, σ : ℝ₊₊) := exp(x/σ)/(exp(x/σ) + exp(y/σ))    :: [id=choice_prob, "the probability that the first alternative is chosen, equation 17"]

[id=arvl_to_dcsn, (a : ℝ₊, aDC : ℝ₊, ξ : ℝ, τ : ℝ₊) : !arvl -> (a_d : ℝ₊, aDC_d : ℝ₊, ξ_d : ℝ, τ_d : ℝ₊) : !dcsn] {
    a_d   = a                                 :: [id=wealth]
    aDC_d = aDC                               :: [id=dc_balance]
    ξ_d   = ξ                                 :: [id=wage_shock]
    τ_d   = τ                                 :: [id=tenure]
}

[id=dcsn_to_cntn, (a_d, aDC_d, ξ_d, τ_d, j : !ctrl @ {db, dc}) : !dcsn -> ()] {
    [label=db, () -> (a_db : ℝ₊, aDC_db : ℝ₊, ξ_db : ℝ, τ_db : ℝ₊) : !cntn] {
        a_db   = a_d
        aDC_db = aDC_d
        ξ_db   = ξ_d
        τ_db   = τ_d
    }
    [label=dc, () -> (a_dc : ℝ₊, aDC_dc : ℝ₊, ξ_dc : ℝ, τ_dc : ℝ₊) : !cntn] {
        a_dc   = a_d
        aDC_dc = aDC_d
        ξ_dc   = ξ_d
        τ_dc   = τ_d
    }
}

[id=cntn_to_dcsn, (V_db[>] : ℝ @ !vlu, V_dc[>] : ℝ @ !vlu) : !cntn -> (V : ℝ @ !vlu) : !dcsn] {
    V        = 𝑙𝑠𝑢𝑚2(V_db[>], V_dc[>] - 𝑢p(t_0), σ_p)                                                                                 :: [id=value, "equation 16 with the taste shocks integrated out; the paper prints the closed form only for the contribution and allocation choices, equations 23 and 24"]
    D_{a_d}V = 𝑝𝑟𝑜𝑏2(V_db[>], V_dc[>] - 𝑢p(t_0), σ_p)*D_{a_db}V_db[>] + (1 - 𝑝𝑟𝑜𝑏2(V_db[>], V_dc[>] - 𝑢p(t_0), σ_p))*D_{a_dc}V_dc[>]  :: [id=marginal, "the derivative of the line above in non-pension wealth; the paper does not print it"]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : ℝ @ !vlu) : !arvl] {
    V[<]  = V                                 :: [id=value]
}

[id=policy, (V_db[>], V_dc[>]) : !cntn -> (j : {db, dc} @ !ctrl) : !dcsn] {
    j = argmax_{j}(V_db[>], V_dc[>] - 𝑢p(t_0))   :: [id=choice, "equation 16 read with ζ_DB = ζ_DC = 0; the paper's selection is the logit of equation 17, which is a conditional distribution over the two labels and not a measurable selection"]
}
