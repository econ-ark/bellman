@stage: terminal_childless

# The continuation of a woman whose attempt failed, after the last date of the
# trellis. The paper's horizon is infinite and it states no terminal condition
# (theory.md, "Conditions the paper omits"), so the trellis ends on the boundary
# data its trellis file names: the value of wealth after the last date, V[>] at
# this stage's continuation perch, a function of wealth supplied at
# realization. The stage computes nothing. Its arrival
# field a_tc differs from cons_childless's a_childless, so the one inter-period
# mapping reaches cons_childless alone.

Xa := ℝ₊₊

[id=arvl_to_dcsn, (a_tc : Xa) : !arvl -> (m_tc : Xa) : !dcsn] {
    m_tc = a_tc                              :: [id=wealth]
}

[id=dcsn_to_cntn, (m_tc) : !dcsn -> (b_tc : Xa) : !cntn] {
    b_tc = m_tc                              :: [id=wealth]
}

[id=cntn_to_dcsn, (V[>] : [-inf, inf) @ !vlu) : !cntn -> (V : [-inf, inf) @ !vlu) : !dcsn] {
    V  = V[>]                                :: [id=value]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : [-inf, inf) @ !vlu) : !arvl] {
    V[<]  = V                                :: [id=value]
}
