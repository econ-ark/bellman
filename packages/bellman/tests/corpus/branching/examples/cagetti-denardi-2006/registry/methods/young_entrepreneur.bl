@methods: young_entrepreneur
# The copy of the test registry: the entry of the enforcement iteration's settings,
# which names no method word and has no form in the language, is left out.
# The methods of the stage young_entrepreneur as an addition to
# young_entrepreneur.bl: value function iteration for the decision value on a grid
# of assets and capital (Appendix B of the paper), the iteration on the
# largest enforceable capital that imposes the line enforcement of the policy
# builder, the identity for the measure the arrival builder carries to the
# decision perch, and a histogram for the measure the decision builder pushes
# forward through its two branches, on the asset coordinate of each branch.
# Each grid is a grid entry, one factor per coordinate (D5). No method adds a
# line, so every selection is a file-level line routed by its path (rule 7);
# the settings of the line enforcement are the word-less group
# enforcement.method of the block policy, written at file level with the
# block id as the first segment. The stage file is refused today (rule
# not-constructed, at its branching block dcsn_to_cntn), so no address below
# is checked against this stage's own places.

n_a : ℕ        :: ["number of points of the asset grid"]
a_min : Xa     :: ["lowest point of the asset grid, the borrowing limit"]
a_max : Xa     :: ["highest point of the asset grid"]
n_k : ℕ        :: ["number of points of the capital grid"]
k_min : ℝ₊     :: ["lowest point of the capital grid, the number 0 in the YAML; the settings file has no key for it"]
k_max : ℝ₊     :: ["highest point of the capital grid, and the first value of the bound on enforceable capital"]
tol_v : ℝ₊₊    :: ["tolerance of value function iteration"]
tol_k : ℝ₊₊    :: ["tolerance of the iteration on the bound on enforceable capital"]

cntn_to_dcsn.method : !vfi(tol=tol_v)
cntn_to_dcsn.grid : !Cartesian(a=(a_min, a_max, n_a), k=(k_min, k_max, n_k))    # no form in §4: orders: [n_a, n_k], bounds: [[a_min, a_max], [0, k_max]], two coordinates by position, none named; a is a state of the decision perch and k a control, neither in the header of cntn_to_dcsn; the YAML's number 0 is the declared setting k_min
arvl_to_dcsn.method : !identity
dcsn_to_cntn.method : !histogram    # no form in §4: on: dcsn_to_cntn, method: !histogram, the method slot of a block whose body is two labeled branches
dcsn_to_cntn.repay.grid : !Cartesian(a_ye_ea=(a_min, a_max, n_a))    # no form in §4: orders: [n_a], bounds: [[a_min, a_max]], one grid for both branches; the asset coordinate differs by branch, so one grid entry per branch, the label a segment of the path (F12)
dcsn_to_cntn.default.grid : !Cartesian(a_ye_wk=(a_min, a_max, n_a))    # no form in §4: as the line above
