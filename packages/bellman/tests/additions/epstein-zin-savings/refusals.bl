@methods: ez_savings
# Deliberate refusals on the stage ez_savings, whose stage file is
# applications/epstein-zin-savings/declaration/stages/ez_savings/ez_savings.bl.
# No block of this file belongs to the application's methods; each is written
# as an author might write it by mistake. The comment above each block says
# why the package refuses the union of that block with the stage file, and
# names the refusal rule. The settings that the blocks read are declared with
# their sets, so that no other problem is reported.

n_Ψ_nodes : ℕ        :: ["quadrature nodes of the gross return"]
n_sim : ℕ            :: ["number of simulated paths"]
sim_seed : ℕ         :: ["seed of the simulation"]

# Refused for two reasons. First, a path that names another block:
# `policy.evaluate.method` begins with the id of the block `policy` inside the
# block `cntn_to_dcsn` (`label-not-in-parent`). Second, one component typed
# twice: `E_Ψ.method` names every occurrence of the operator E_Ψ in the block,
# here the one in the line `value`, and `value.E_Ψ.method` names that
# occurrence by its line; the two entries type one method at one place by two
# paths, and the package refuses the second and names both
# (`component-typed-twice`). The derivative line is the one that the
# application's methods file adds.
[id=cntn_to_dcsn
    | E_Ψ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes)
    | value.E_Ψ.method : !monte_carlo(n_paths=n_sim, seed=sim_seed)
    | policy.evaluate.method : !Linear] {
    D_{m_d}V = (1-β)*c^(-ρ)*V^ρ        :: [id=marginal]
}

# Refused for two reasons. First, two sets on one coordinate: the signature
# that the block writes gives the control c the set ℝ₊, which admits zero
# consumption, where the stage's signature of dcsn_to_cntn gives it ℝ₊₊
# (`type-conflict`). Second, one line id twice: the line restates the law of
# motion under its id `savings`, which the stage's block already holds
# (`declared-twice`).
[id=dcsn_to_cntn, (c : !ctrl @ ℝ₊) : !dcsn -> ()] {
    a = (m_d - c)*Ψ        :: [id=savings]
}
