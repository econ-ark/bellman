@methods: Port2
# The methods of the stage Port2, the stage file port.bl under a second name,
# as an addition to Port2.bl: the selections of methods.port.bl, from the same
# YAML entries, written in the flat form of the methods file, one declaration
# line per selection with the full path, routed by the union to the node the
# path names (rule 7). Only the derivative line of marginals_Port2.bl is written
# in a block, since a line belongs to a body. The stage-wide address E_Ψ_θ
# becomes one line per occurrence, each a path through a line id to the
# operator: cntn_to_dcsn.value, cntn_to_dcsn.marginal, which the addition
# creates, and policy.foc. Both files give one record per selection
# (requirement 1 of the proposal).

n_k : ℕ                                   :: ["number of points of the capital grid"]
k_min : ℝ₊                                :: ["lower bound of the capital grid"]
k_max : ℝ₊                                :: ["upper bound of the capital grid"]
n_Ψ_nodes : ℕ                             :: ["quadrature nodes of the return shock"]
n_θ_nodes : ℕ                             :: ["quadrature nodes of the income shock"]

[id=cntn_to_dcsn] {
    D_{k_d}V = E_{Ψ,θ}(D_{m_next}V[>]*(ς*Ψ + (1-ς)*R))   :: [id=marginal]
}

cntn_to_dcsn.method : !vfi    # no form in §4: handler: cons-port:share_search
cntn_to_dcsn.handler : "cons-port:share_search"
cntn_to_dcsn.grid : !Cartesian(k_d=(k_min, k_max, n_k, !expmult))    # no form in §4: orders: {k_d: n_k}, bounds: {k_d: [k_min, k_max]} on !vfi with no grid kind; grid_spacing: expmult, in settings/port_wide.yml and named by no entry
cntn_to_dcsn.value.E_Ψ_θ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes, n_θ=n_θ_nodes)    # no form in §4: on: E_Ψ_θ, the stage-wide address; handler: cons-port:gauss_hermite
cntn_to_dcsn.value.E_Ψ_θ.handler : "cons-port:gauss_hermite"
cntn_to_dcsn.marginal.E_Ψ_θ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes, n_θ=n_θ_nodes)    # no form in §4: on: E_Ψ_θ, the stage-wide address; handler: cons-port:gauss_hermite
cntn_to_dcsn.marginal.E_Ψ_θ.handler : "cons-port:gauss_hermite"
policy.foc.E_Ψ_θ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes, n_θ=n_θ_nodes)    # no form in §4: on: E_Ψ_θ, the stage-wide address; handler: cons-port:gauss_hermite
policy.foc.E_Ψ_θ.handler : "cons-port:gauss_hermite"
cntn_to_dcsn.evaluate[V].method : !Linear
cntn_to_dcsn.evaluate[V].grid : !Cartesian(k_d=(k_min, k_max, n_k, !expmult))    # no form in §4: grid_spacing: expmult, in settings/port_wide.yml and named by no entry
