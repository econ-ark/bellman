@methods: port
# The methods of the portfolio stage as an addition to port.bl, in the bracket
# form: value function iteration on the decision value builder, a search over
# the share realized by the routine share_search of cons_port_tool.py, on the
# capital grid; Gauss-Hermite quadrature at the expectation over the two
# shocks, one node count per shock, realized by the routine gauss_hermite; the
# derivative line of the decision value from marginals_port.bl; and the linear
# representation of the decision value on the capital grid. The YAML's
# stage-wide address E_Ψ_θ becomes a group in each block that holds an
# occurrence: in cntn_to_dcsn, where after the union it names the occurrences of
# the lines value and marginal, and in policy, where it names the occurrence of
# the line foc; policy gains no line, so its group is a file-level line. The
# capital grid is multi-exponential in settings/port_wide.yml, which no YAML
# entry names; the spacing is written as the fourth element, !expmult, of the
# grid entry of each place that reads the grid (D5, writer's sheet §7).
# Methods.Port2.bl writes the same selections in the flat form.

n_k : ℕ                                   :: ["number of points of the capital grid"]
k_min : ℝ₊                                :: ["lower bound of the capital grid"]
k_max : ℝ₊                                :: ["upper bound of the capital grid"]
n_Ψ_nodes : ℕ                             :: ["quadrature nodes of the return shock"]
n_θ_nodes : ℕ                             :: ["quadrature nodes of the income shock"]

[id=cntn_to_dcsn, method : !vfi
    | handler : "cons-port:share_search"
    | cntn_to_dcsn.grid : !Cartesian(k_d=(k_min, k_max, n_k, !expmult))
    | E_Ψ_θ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes, n_θ=n_θ_nodes)
    | E_Ψ_θ.handler : "cons-port:gauss_hermite"
    | evaluate[V].method : !Linear
    | evaluate[V].grid : !Cartesian(k_d=(k_min, k_max, n_k, !expmult))] {    # no form in §4: handler: cons-port:share_search; handler: cons-port:gauss_hermite; on: E_Ψ_θ, the stage-wide address; grid_spacing: expmult, in settings/port_wide.yml and named by no entry, written as the spacing word of the two grids
    D_{k_d}V = E_{Ψ,θ}(D_{m_next}V[>]*(ς*Ψ + (1-ς)*R))   :: [id=marginal]
}

policy.E_Ψ_θ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes, n_θ=n_θ_nodes)    # no form in §4: on: E_Ψ_θ, the stage-wide address; handler: cons-port:gauss_hermite
policy.E_Ψ_θ.handler : "cons-port:gauss_hermite"
