@methods: adjuster_cons
# A second methods file of the adjuster's consumption stage, for the recipe's
# slot $adjuster_method (applications/durables/declaration/spec.yml and
# spec.two-stages.yml, methods all: [stages/adjuster_cons/methods,
# $adjuster_method]), which the application leaves unbound. It carries the one
# entry the factory's acceptance test binds to that slot, value function
# iteration on the decision value builder realized by the routine
# make_adjuster_vfi of the replication code, the nested method that the comment
# at the foot of adjuster_cons/methods.yml describes as replacing the
# endogenous grid entry. It is added after methods.adjuster_cons.bl, in the
# recipe's order, and reaches the adjuster at every period of the trellis. The
# block cntn_to_dcsn gains no line here, so the selection is a file-level line
# routed by its path; an empty body is refused.

cntn_to_dcsn.method : !vfi    # no form in §4: handler: fues-durables:make_adjuster_vfi, with no settings
cntn_to_dcsn.handler : "fues-durables:make_adjuster_vfi"
