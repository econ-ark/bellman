@methods: tenure
# Deliberate refusals on the tenure stage, whose stage file is
# applications/durables/declaration/stages/tenure/tenure.bl. No item of this
# file belongs to the application's methods; each is written as an author
# might write it by mistake. The comment above each item says why the package
# refuses the union of that item with the stage file, and names the refusal
# rule. Each block carries a line, since the package refuses a block with an
# empty body. The settings that the items read are declared with their sets,
# so that the settings cause no refusal and only the deliberate refusals are
# reported.

N_wage : ℕ                                :: ["number of states of Tauchen's chain for the income state"]
tauchen_n_std : ℝ₊₊                       :: ["number of unconditional standard deviations the chain spans"]
tauchen_min_prob : (0,1)                  :: ["floor on the transition probabilities of the chain"]
n_ε_nodes : ℕ                             :: ["quadrature nodes of the innovation to log income"]
n_a : ℕ                                   :: ["number of points of the asset grid"]
a_min : ℝ₊                                :: ["lower bound of the asset grid"]
a_max : ℝ₊                                :: ["upper bound of the asset grid"]
n_h : ℕ                                   :: ["number of points of the housing grid"]
h_min : ℝ₊₊                               :: ["lower bound of the housing grid"]
h_max : ℝ₊₊                               :: ["upper bound of the housing grid"]

# Refused: one component written twice. The first and the third line name
# one component, the method of the expectation E_ε in the line value of
# dcsn_to_arvl, by one path, and give it two different methods: Tauchen's
# chain, and Gauss-Hermite quadrature, the rule that the declared law
# ε ~ N(0, 1) suggests to an author who keeps both. The package refuses the
# second entry and names both (`declared-twice`).
dcsn_to_arvl.value.E_ε.method : !tauchen(n_income_states=N_wage, n_std=tauchen_n_std, min_prob=tauchen_min_prob)
dcsn_to_arvl.value.E_ε.handler : "fues-durables:make_conditioners"
dcsn_to_arvl.value.E_ε.method : !gauss_hermite(n_ε=n_ε_nodes)

# Refused for two reasons. First, two sets on one coordinate: the signature
# that the block writes, its empty domain adding nothing, gives the decision
# state a_d the set ℝ₊₊, taken from the lower bound a_min > 0 of the asset
# grid, where the stage's signature of arvl_to_dcsn gives it ℝ₊; the settings
# file of the application says that the model admits zero saving and that the
# floor is numerical (`type-conflict`). Second, one line id twice: the line
# income_state is restated to give the block a body, and the stage's block
# arvl_to_dcsn already holds that id (`declared-twice`).
[id=arvl_to_dcsn, () -> (a_d : ℝ₊₊) : !dcsn] {
    z_d = z^ρ_z*exp(σ_z*ε)                              :: [id=income_state]
}

# Refused: one line id twice inside a branch. The nested block merges with the
# branch keep of dcsn_to_cntn by its label, and its line, the branch's law of
# cash on hand copied to open the branch, carries the id cash_on_hand, which
# that branch already holds (`declared-twice`).
[id=dcsn_to_cntn] {
    [label=keep] {
        w_kp = R*a_d + 𝑦(z_d)                           :: [id=cash_on_hand]
    }
}

# Refused: a path that names another block. The block dcsn_marginal has an id
# of its own, and the representation of the decision value, its method and
# its grid, is written inside it; the path of each entry begins with
# cntn_to_dcsn, a block other than the enclosing one (`label-not-in-parent`).
# Without the two entries the union keeps dcsn_marginal as a new block, a
# second builder from the continuation perch to the decision perch beside
# cntn_to_dcsn, which the package refuses as well (`one-builder-per-output`).
[id=dcsn_marginal, (V_kp[>], V_adj[>], d) : !cntn -> (V) : !dcsn
    | cntn_to_dcsn.evaluate[V].method : !Linear
    | cntn_to_dcsn.evaluate[V].grid : !Cartesian(a_d=(a_min, a_max, n_a), h_d=(h_min, h_max, n_h))] {
    D_{a_d}V = (R*D_{w_kp}V_kp[>], R*D_{w_adj}V_adj[>])[d]                          :: [id=marginal_assets]
    D_{h_d}V = ((1 - δ)*D_{h_kp}V_kp[>], R_H*(1 - δ)*D_{w_adj}V_adj[>])[d]          :: [id=marginal_housing]
}
