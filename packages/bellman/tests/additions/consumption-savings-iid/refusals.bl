@methods: cons_savings_iid
# Deliberate refusals on the stage cons_savings_iid, whose stage file is
# applications/consumption-savings-iid/declaration/stages/cons_savings_iid/cons_savings_iid.bl.
# No item of this file belongs to the application's methods; each is written
# as an author might write it by mistake. The comment above each item says
# why the package refuses the union of that item with the stage file, and
# names the refusal rule. The settings are declared as in methods.bl, and the
# grid is an entry of its own in the bracket of the block policy, so that only
# the refusals remain.

n_a : ℕ          :: ["number of points of the savings grid"]
a_min : ℝ₊       :: ["lower bound of the savings grid"]
a_max : ℝ₊       :: ["upper bound of the savings grid"]

# Refused: a name defined in both files with different content
# (`declared-twice`). The stage file defines 𝑑𝑢𝑖𝑛𝑣 := Inv(𝑑𝑢); an author who
# copies the closed form of the inverse marginal utility from another methods
# file defines the name a second time. The application's methods file asks
# for the closed form by a method at the definition instead.
𝑑𝑢𝑖𝑛𝑣(x : ℝ₊₊) := x^(-1/γ)

# Refused: one component written twice. The relative path evaluate.method and
# the absolute path policy.evaluate.method name one component, the method of
# the Evaluation of policy, since a path inside a block's bracket is read
# relative to the block, and they give it two different representations. The
# package refuses the second entry and names both (`declared-twice`).
[id=policy, method : !egm
    | grid : !Cartesian(a=(a_min, a_max, n_a))
    | evaluate.method : !Linear
    | policy.evaluate.method : !pchip] {
    c[>] = 𝑑𝑢𝑖𝑛𝑣(β*D_{a}V[>])       :: [id=InvEuler]
    w[>] = a + c[>]                 :: [id=g_cntn_to_dcsn]
}

# Refused: a path that names another block. The path of the entry begins with
# dcsn_to_arvl, a block other than the enclosing cntn_to_dcsn, so it would type
# the representation of the arrival value from inside the decision builder
# (`label-not-in-parent`). The envelope line is the one methods.bl adds.
[id=cntn_to_dcsn
    | dcsn_to_arvl.evaluate.method : !Linear] {
    D_{w}V = 𝑑𝑢(c)                  :: [id=marginal]
}

# Refused for two reasons. First, two sets on one coordinate: the signature
# that the block writes appends nothing to the domain, by its empty side, and
# gives the arrival value V[<] the set ℝ₊, where the stage's signature of
# dcsn_to_arvl gives it ℝ (`type-conflict`); with γ > 1 the value is negative,
# so the author's set is also false. Second, one line id twice: the derivative
# line is written under the id value, which the stage's line V[<] = E_{y}(V) of
# the same block already holds (`declared-twice`).
[id=dcsn_to_arvl, () -> (V[<] : ℝ₊ @ !vlu) : !arvl] {
    D_{b}V[<] = E_{y}(R * D_{w}V)   :: [id=value]
}
