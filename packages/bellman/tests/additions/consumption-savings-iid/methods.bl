@methods: cons_savings_iid
# The methods of the consumption-savings stage with independent income, whose
# stage file is
# applications/consumption-savings-iid/declaration/stages/cons_savings_iid/cons_savings_iid.bl,
# as an addition to that file. The endogenous grid method stands on the
# policy builder with its grid of savings a; its three lines, the inverted
# Euler equation, the inverted law of motion and the identification of the
# chosen consumption with the candidate, stand in place of the maximization
# at the operative level, and stage.declared keeps the maximization. Each
# value builder gains its derivative line: the envelope condition of the
# decision value, and the derivative of the arrival value. The other entries
# of the stage stand in methods.additions.bl, which is read after this file;
# the application's methods file,
# applications/consumption-savings-iid/declaration/stages/cons_savings_iid/methods.bl,
# holds the union of the two files.

# The settings this file reads, declared with their sets: the bounds are
# points of ℝ₊, the set the stage gives the savings a, and the count is in ℕ.
# Their values stand in the settings file of the application,
# applications/consumption-savings-iid/declaration/settings/cons_savings_iid.yml.
# The grid of savings is the grid entry policy.grid of the block policy,
# written in the bracket of the block below.
n_a : ℕ          :: ["number of points of the savings grid"]
a_min : ℝ₊       :: ["lower bound of the savings grid"]
a_max : ℝ₊       :: ["upper bound of the savings grid"]

# The endogenous grid method, its grid of savings on the coordinate a, and its
# three lines: the inverted Euler equation, the inverted law of motion and the
# identification of the decision's consumption with the candidate, which the
# package reads in place of the maximization of the stage file.
[id=policy, method : !egm
    | policy.grid : !Cartesian(a=(a_min, a_max, n_a))] {
    c[>] = 𝑑𝑢𝑖𝑛𝑣(β*D_{a}V[>])       :: [id=InvEuler]
    w[>] = a + c[>]                 :: [id=g_cntn_to_dcsn]
    c[~] = c[>]                     :: [id=cons_choice]
}

# The envelope line of the decision value.
[id=cntn_to_dcsn] {
    D_{w}V = 𝑑𝑢(c)                  :: [id=marginal]
}

# The derivative line of the arrival value, with the factor R of the law of
# motion w = y + b*R.
[id=dcsn_to_arvl] {
    D_{b}V[<] = E_{y}(R * D_{w}V)   :: [id=marginal]
}
