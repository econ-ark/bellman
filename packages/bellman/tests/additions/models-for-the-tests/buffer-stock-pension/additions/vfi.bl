@methods: buffer_stock
# Value function iteration at the last working occurrence, read after
# pension.bl in place of egm.bl: the decision value is built by maximization
# on the grid of resources and balances, the builder's own grid entry; the
# maximization of the policy line is computed by bounded scalar maximization;
# and one entry at the decision builder's Evaluation, whose grid entry names
# the same two factors, represents the decision value and its two stated
# derivatives. The entries stand at file level with their full paths and no
# block, since no line is added and the package refuses a block with an empty
# body; one names an operator inside a line. The three declarations of the
# settings of the balance grid repeat those of pension.bl word for word, and
# a name written in both files is one item where the two are equal.

n_m : ℕ              :: ["number of points of the resources grid"]
m_min : Xm           :: ["lower bound of the resources grid"]
m_max : Xm           :: ["upper bound of the resources grid"]
n_p : ℕ              :: ["number of points of the pension-balance grid"]
p_min : Xp           :: ["lower bound of the pension-balance grid"]
p_max : Xp           :: ["upper bound of the pension-balance grid"]

cntn_to_dcsn.method : !vfi
cntn_to_dcsn.grid : !Cartesian(m=(m_min, m_max, n_m), p_d=(p_min, p_max, n_p))
policy.optimality.argmax.method : !scipy_bounded
cntn_to_dcsn.evaluate.method : !Linear
cntn_to_dcsn.evaluate.grid : !Cartesian(m=(m_min, m_max, n_m), p_d=(p_min, p_max, n_p))
