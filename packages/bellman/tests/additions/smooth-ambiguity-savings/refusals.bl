@methods: sa_savings
# Deliberate refusals on the stage sa_savings, whose stage file is
# applications/smooth-ambiguity-savings/declaration/stages/sa_savings/sa_savings.bl.
# No item of this file belongs to the application's methods; each is written
# as an author might write it by mistake. The comment above each item says
# whether and why the package refuses it, and names the refusal rule.

m_min : ℝ₊₊          :: ["lower bound of the grid of resources"]
m_max : ℝ₊₊          :: ["upper bound of the grid of resources"]
n_m : ℕ              :: ["number of points of the grid of resources"]
n_Ψ_nodes : ℕ        :: ["quadrature nodes of the return given the mean of its log"]
n_Ψ_wide : ℕ         :: ["quadrature nodes of a wider rule for the same expectation"]

# Admitted: a path at file level whose first segment names no block. E_Ψ is
# the name of an operator alone, so the entry stays at file level and types
# the method of every occurrence of E_Ψ in the stage, in its two blocks.
# Elaborated with the settings above and no other item, this line forms a
# union that the package admits. It stands here as the one admitted item of
# the file. Each block below is refused without it, as the comment above the
# block says.
E_Ψ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes)

# Refused for three reasons. First, two sets on one coordinate: the signature
# that the block writes gives the continuation value V[>] the set ℝ, as a stage
# with a CRRA value, negative for ρ > 1, would, where this stage's Epstein–Zin
# aggregation keeps it in ℝ₊₊ (`type-conflict`). Second, one component typed
# twice: in this block E_Ψ occurs once, in the line risk_ce, so the operator's
# name and the line's path reach one place, and the two entries give it two
# node counts (`component-typed-twice`). Third, one component typed twice:
# `evaluate.method` represents everything the Evaluation stores, the value
# among it, so `evaluate[V].method` types the value's representation a second
# time (`component-typed-twice`).
[id=cntn_to_dcsn, (V[>] : ℝ @ !vlu) : !cntn -> ()
    | E_Ψ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes)
    | risk_ce.E_Ψ.method : !gauss_hermite(n_Ψ=n_Ψ_wide)
    | evaluate.method : !Linear
    | evaluate.grid : !Cartesian(m_d=(m_min, m_max, n_m))
    | evaluate[V].method : !pchip] {
    D_{m_d}V = (1-β)*c^(-ρ)*V^ρ    :: [id=marginal]
}

# Refused for two reasons. First, a path that names another block: the path
# of the entry begins with cntn_to_dcsn, a block other than the enclosing
# policy (`label-not-in-parent`). Second, one line id twice: the author,
# believing that a method must stand beside the line it solves, copies the
# maximization into the methods file under its id objective, which the
# stage's block already holds (`declared-twice`).
[id=policy
    | cntn_to_dcsn.risk_ce.E_Ψ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes)] {
    c = argmax_{c : Γ(m_d)}(((1-β)*c^(1-ρ) + β*E_{ν}(E_{Ψ}(V[>]^(1-γ))^((1-η)/(1-γ)))^((1-ρ)/(1-η)))^(1/(1-ρ))) :: [id=objective]
}
