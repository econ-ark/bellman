@methods: cons
# Four additions to cons.bl that the package refuses, each a mistake that an
# author could make in writing the methods of cons-port. They are not methods
# of the application and stand apart from its methods files. The comment above
# each item says why the package refuses it, and names the refusal rule.

𝑑𝑢(c : ℝ₊₊) := c^(-ρ)
𝑑𝑢𝑖𝑛𝑣(x : ℝ₊₊) := x^(-1/ρ)

n_a : ℕ              :: ["number of points of the savings grid"]
a_min : Xa           :: ["lower bound of the savings grid"]
a_max : Xa           :: ["upper bound of the savings grid"]
n_m : ℕ              :: ["number of points of the grid of resources"]
m_min : Xm           :: ["lower bound of the grid of resources"]
m_max : Xm           :: ["upper bound of the grid of resources"]

# Refused: a name defined in both files with different content. cons.bl
# defines the set of the savings as Xa := ℝ₊, and the author narrows it because
# the savings grid begins at a_min > 0, taking the method's grid for the
# model's domain. A name is defined once, or identically in each file, so the
# package refuses the second definition (`declared-twice`).
Xa := ℝ₊₊

# Refused: one line id in both files. The inverse Euler line takes the id
# optimality, which the maximization of cons.bl already carries in the block
# policy. A line id names one line of a block, so the package refuses the
# union (`declared-twice`).
[id=policy] {
    c[>] <= 𝑑𝑢𝑖𝑛𝑣(D_{a}V[>]) ⟂ a >= 0      :: [id=optimality]
    m[>] = a + c[>]                          :: [id=grid]
}

# Refused: one component written twice. Two entries type the method of the
# Evaluation of the decision value, as `!Linear` and as `!pchip`, the
# shape-preserving cubic. A component holds one entry over the files of a
# stage, so the package refuses the second entry and names both
# (`declared-twice`).
[id=cntn_to_dcsn
    | evaluate.method : !Linear
    | evaluate.method : !pchip
    | evaluate.grid : !Cartesian(m=(m_min, m_max, n_m))] {
    D_{m}V = 𝑑𝑢(c)                           :: [id=envelope]
}

# Refused: a path inside a block that names another block. The block egm types
# the method and the handler of the policy builder inside it
# (`label-not-in-parent`). Without those two entries, the union keeps egm as
# a second builder from the continuation perch to the decision perch that
# writes c, which the package refuses as well (`one-builder-per-output`).
[id=egm, policy.method : !egm,
    (V[>] : ℝ @ !vlu) : !cntn -> (c : ℝ₊₊ @ !ctrl) : !dcsn
    | policy.handler : "cons-port:egm"] {
    c[>]   <= 𝑑𝑢𝑖𝑛𝑣(D_{a}V[>]) ⟂ a >= 0    :: [id=InvEuler]
    m[>]   = a + c[>]                        :: [id=grid]
    c      = c[>]                            :: [id=identification]
}
