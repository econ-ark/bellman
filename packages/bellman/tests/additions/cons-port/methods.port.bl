@methods: port
# The methods of the portfolio stage at the occurrences that methods/port.yml
# serves, as an addition to port.bl: time iteration on the policy builder with
# the first-order condition of the share from port_foc.bl, realized by the
# function share_search of cons_port_tool.py, which compares n_ς shares on the
# feasible set at each point of the capital grid; Gauss-Hermite quadrature at
# every occurrence of the expectation; the envelope line of the decision value
# from port_foc.bl; the linear representation of the decision value and of its
# stated derivative on the capital grid; and the forward law drawn by Monte
# Carlo. Under D8 (decided) the line euler stands in place of the maximization
# at the operative level, and stage.declared keeps the maximization. Each grid
# is its own typing entry at its place (D5, decided).

n_k : ℕ              :: ["number of points of the capital grid"]
k_min : ℝ₊           :: ["lower bound of the capital grid"]
k_max : ℝ₊           :: ["upper bound of the capital grid"]
n_ς : ℕ              :: ["number of shares the search compares"]
n_Ψ_nodes : ℕ        :: ["quadrature nodes of the return shock"]
n_θ_nodes : ℕ        :: ["quadrature nodes of the income shock"]
n_sim : ℕ            :: ["number of simulated paths"]
sim_seed : ℕ         :: ["seed of the simulation"]

[id=policy, policy.method : !time_iteration
    | policy.handler : "cons-port:share_search"
    | policy.grid : !Cartesian(ς=(Γ_ς, n_ς))
    | E_Ψ_θ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes, n_θ=n_θ_nodes)
    | E_Ψ_θ.handler : "cons-port:gauss_hermite"] {    # no form in §4: handler: cons-port:share_search; no grid in the entry, the handler reading n_ς by name; handler: cons-port:gauss_hermite; on: E_Ψ_θ, the stage-wide address
    ς = solve_{ς}(E_{Ψ,θ}(D_{w}V[>]*(Ψ - R)))       :: [id=euler]
}

[id=cntn_to_dcsn
    | E_Ψ_θ.method : !gauss_hermite(n_Ψ=n_Ψ_nodes, n_θ=n_θ_nodes)
    | E_Ψ_θ.handler : "cons-port:gauss_hermite"
    | evaluate.method : !Linear
    | evaluate.grid : !Cartesian(k=(k_min, k_max, n_k, !expmult))] {    # no form in §4: handler: cons-port:gauss_hermite; on: E_Ψ_θ, the stage-wide address; grid_spacing: expmult, in settings/port_wide.yml
    D_{k}V = E_{Ψ,θ}(D_{w}V[>]*(ς*Ψ + (1-ς)*R))     :: [id=envelope]
}

dcsn_to_cntn.method : !monte_carlo(n_paths=n_sim, seed=sim_seed)
