@methods: owner_cons
# The alternative selection of the owner's consumption stage that the comment
# in stages/owner_cons/methods.yml records for the reference solutions of the
# paper's tables: value function iteration on a dense grid in place of the
# !egm entry, the other entries unchanged. It is written as a methods file of
# its own that replaces the complete selection of methods.owner_cons.bl, never
# one entry of it (the proposal's §4 and D3), so it restates the envelope line
# and the two representations and holds no line of the endogenous grid method.
# The variant name vfi is the method word, since the alternative has no YAML
# file of its own. stages/renter_cons/methods.yml records the same alternative
# for the renter's stage; it is not written again here.
#
# The comment writes on: policy, which today's loader refuses for !vfi, asking
# for the backward decision builder cntn_to_dcsn (TargetError of
# _backward_decision_builder_place in packages/bellman/bellman/stage/method_table.py,
# probe of 4 November 2026); the addition writes the method in the bracket of
# cntn_to_dcsn, the builder the catalogue's row admits. The comment gives the
# dense grid by its count alone, n_grid: N_arg_grid_vfi, which the loader
# refuses as an unknown option of !vfi. Under D5 (decided; writer's sheet §7)
# the count is the count of a grid entry beside the method; the settings file
# calls it the dense grid of value function iteration, and the addition reads
# it as the grid of the control c over its feasible set Γ(w_d), the form §7
# gives a control's factor.
#
# The grids of the two Evaluations are those of methods.owner_cons.bl, one
# factor per coordinate of the stored value (finding F67). Every setting and
# parameter the file reads is declared with its set (writer's sheet §6).

N_arg_grid_vfi : ℕ        :: ["number of points of the dense grid of value function iteration"]
w_points : ℕ              :: ["number of points of the cash grid"]
w_min : ℝ₊₊               :: ["lower bound of the cash grid"]
w_max : ℝ₊₊               :: ["upper bound of the cash grid"]
H_min  : ℝ₊               :: ["smallest housing size"]    # no form in §4: a parameter of owner_housing.bl, declared again for the factor of H_d
H_max  : ℝ₊₊              :: ["largest housing size"]    # no form in §4: a parameter of owner_housing.bl, declared again for the factor of H_d
n_H    : ℕ                :: ["number of housing sizes"]    # no form in §4: a parameter of owner_housing.bl, declared again for the factor of H_d
z      : ℝ₊₊              :: ["the income levels of the chain; ℝ₊₊ stands in for the vector, whose length the discretization of the income process fixes"]    # no form in §4: a parameter of tenure_choice.bl, declared again for the factor of y_d

[id=cntn_to_dcsn, method : !vfi
    | grid : !Cartesian(c=(Γ, N_arg_grid_vfi))
    | evaluate[V].method : !Linear
    | evaluate[V].grid : !Cartesian(w_d=(w_min, w_max, w_points), H_d=(H_min, H_max, n_H), y_d=z)
    | evaluate[D_{w_d}V].method : !Linear
    | evaluate[D_{w_d}V].grid : !Cartesian(w_d=(w_min, w_max, w_points), H_d=(H_min, H_max, n_H), y_d=z)] {    # no form in §4: on: policy, method: !vfi, settings: {n_grid: N_arg_grid_vfi}, in a comment of the YAML; the catalogue row places !vfi on cntn_to_dcsn, and the count n_grid, with no bounds and no coordinate, is read as the grid of the control c
    D_{w_d}V = 𝑑𝑢(c)                      :: [id=marginal]
}
