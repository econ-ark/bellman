@methods: tenure_choice
# Deliberate refusals on the branching stage tenure_choice, whose stage file
# is
# applications/housing-renting/declaration/stages/tenure_choice/tenure_choice.bl.
# No item of this file belongs to the application's methods; each is written
# as an author might write it by mistake. The comment above each item says why
# the package refuses the union of that item with the stage file, and names
# the refusal rule. The third block is a nested block with a label, which
# merges with the stage's branch of the same label under its parent block,
# and the signature that it writes has an empty side. The settings that the
# items read are declared with their sets, so that the settings cause no
# refusal.

a_points : ℕ       :: ["number of points of the asset grid"]
a_min : ℝ₊         :: ["lower bound of the asset grid"]
a_max : ℝ₊         :: ["upper bound of the asset grid"]
H_min  : ℝ₊        :: ["smallest housing size"]
H_max  : ℝ₊₊       :: ["largest housing size"]
n_H    : ℕ         :: ["number of housing sizes"]

# Refused for two reasons. First, one line id twice: the derivative of the
# arrival value in the assets a is written under the id value, which the
# stage's line V[<] = E_{y}(V) of the block dcsn_to_arvl already carries
# (`declared-twice`). Second, one component written twice: the expectation
# over the finite income chain is the sum over the row of Π at y_pre, and the
# author writes !sum at file level and !markov in the bracket of the block.
# The path dcsn_to_arvl.E_y.method at file level and the relative path
# E_y.method in the bracket name one component, the method of the operator
# E_y in dcsn_to_arvl, and the package refuses the second entry and names
# both (`declared-twice`).
dcsn_to_arvl.E_y.method : !sum

[id=dcsn_to_arvl
    | E_y.method : !markov] {
    D_{a}V[<] = E_{y}(D_{a_d}V)    :: [id=value]
}

# Refused: a path that names another block. The author adds the arrival
# value's linear representation in the block that holds the other entries;
# the first segment of its path is dcsn_to_arvl, a block other than the
# enclosing cntn_to_dcsn (`label-not-in-parent`). Without that entry the grid
# is refused in its turn, since its factor y_d=E_y takes the nodes of E_y for
# a coordinate that is no shock (`grid-coordinate`).
[id=cntn_to_dcsn
    | evaluate.method : !Linear
    | evaluate.grid : !Cartesian(a_d=(a_min, a_max, a_points), H_d=(H_min, H_max, n_H), y_d=E_y)
    | dcsn_to_arvl.evaluate.method : !Linear] {
    D_{a_d}V = (D_{a_o}V_o[>], (1 + r - 𝑑𝑇(a_d))*D_{w_r}V_r[>])[d]  :: [id=choice_marginal]
}

# Refused for two reasons, on a nested block with a label. First, two sets on
# one coordinate: the author restates the branch rent of the branching block
# dcsn_to_cntn to narrow the liquidated wealth w_r to ℝ₊₊, where the stage's
# branch gives ℝ₊. The nested block merges with the stage's branch of the
# same label under its parent; the empty domain of its signature adds
# nothing, and its coordinate w_r keeps the stage's set (`type-conflict`).
# Second, one line id twice: since the package refuses a block with an empty
# body, the author copies the branch's line with its id liquidation, which the
# stage's branch already carries (`declared-twice`).
[id=dcsn_to_cntn] {
    [label=rent, () -> (w_r : ℝ₊₊) : !cntn] {
        w_r = (1 + r)*a_d - 𝑇(a_d) + H_d    :: [id=liquidation]
    }
}
