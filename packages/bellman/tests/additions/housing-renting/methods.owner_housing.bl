@methods: owner_housing
# The methods of the owner's housing stage as an addition to
# applications/housing-renting/declaration/stages/owner_housing/owner_housing.bl,
# rewritten from stages/owner_housing/methods.yml and the block file
# methods/marginals_owner_housing.bl: the discrete choice over the housing
# sizes of XH on the policy builder; the derivative of the decision value in
# the assets a_d, the derivative of the continuation value in cash times the
# derivative of the owner's budget in assets, from marginals_owner_housing.bl
# with its doc string; and one linear representation of the decision value and
# of its stated derivative, for the YAML's two equal entries, with its grid as
# an entry of its own (D5, decided; writer's sheet §7).
#
# The policy builder gains no line, and a block of a methods file may not have
# an empty body, so its method is a file-level line routed by its path to the
# block policy (rule 7; finding F24). The entry on dcsn_to_cntn, with on alone,
# binds nothing and is not written (writer's sheet §5).
#
# The grid has one factor per coordinate of the stored value, (a_d, H_d, y_d)
# (finding F67): the YAML's asset grid, the housing sizes by the triple the
# stage itself declares, H_min, H_max, n_H, and the income by the levels z of
# the income chain, the parameter of tenure_choice.bl.
#
# The stage file is refused by the elaborator today (rule not-constructed, the
# definition XH := linspace(H_min, H_max, n_H) of its line 3; writer's sheet
# §4.5, finding F5), so the checker resolves no address of this file against
# the stage's own places.
#
# The three settings the file reads are declared with their sets (writer's
# sheet §6): the bounds as points of ℝ₊, the set owner_housing.bl gives the
# assets a_d, and the count in ℕ; z is declared as tenure_choice.bl declares it.

a_points : ℕ       :: ["number of points of the asset grid"]
a_min : ℝ₊         :: ["lower bound of the asset grid"]
a_max : ℝ₊         :: ["upper bound of the asset grid"]
z     : ℝ₊₊        :: ["the income levels of the chain; ℝ₊₊ stands in for the vector, whose length the discretization of the income process fixes"]    # no form in §4: a parameter of tenure_choice.bl, declared again for the factor of y_d

policy.method : !discrete_choice

[id=cntn_to_dcsn
    | evaluate.method : !Linear
    | evaluate.grid : !Cartesian(a_d=(a_min, a_max, a_points), H_d=(H_min, H_max, n_H), y_d=z)] {
    D_{a_d}V = (1 + r - 𝑑𝑇(a_d))*D_{w_own}V[>]    :: [id=marginal, "the derivative with respect to the assets a_d, which enter cash after tax"]
}
