@methods: renter_cons
# The methods of the renter's consumption stage as an addition to
# applications/housing-renting/declaration/stages/renter_cons/renter_cons.bl,
# rewritten from stages/renter_cons/methods.yml and the block files
# methods/renter_cons_egm.bl and methods/marginals_renter_cons.bl: the
# endogenous grid method on the policy builder, with the six further settings
# the YAML names beside it and its grid of the savings a_nxt_r as a grid entry
# of its own (D5, decided; writer's sheet §7); the three lines of
# renter_cons_egm.bl; the envelope line of the decision value from
# marginals_renter_cons.bl; and one linear representation of the decision value
# and of its stated derivative, for the YAML's two equal entries on
# cntn_to_dcsn.evaluate.value and cntn_to_dcsn.evaluate.marginal.
#
# The selections are those of methods.owner_cons.bl, written in the other
# spelling the proposal's §4 admits for each: the block's method and grid by
# the relative subjects method and grid, and one unrefined pair evaluate.method
# and evaluate.grid for the two Evaluations (D4; finding F6). The three lines
# of renter_cons_egm.bl are written as the block file writes them, the
# identification c = c[>] among them (decision D8, decided; the proposal's §4,
# rule 5). The entry on dcsn_to_cntn, with on alone, binds nothing and is not
# written.
#
# The grid of the Evaluation has one factor per coordinate of the stored value,
# (w_d, S_d, y_d) (writer's sheet §7; finding F67): the rented services S_d take
# the n_S quantities, the triple of renter_housing.bl, and the income y_d the
# levels z of the income chain, the parameter of tenure_choice.bl.
#
# Every setting the file reads is declared with its set (writer's sheet §6),
# as in methods.owner_cons.bl: the savings a_nxt_r is in ℝ₊ and the cash w_d
# in ℝ₊₊ in renter_cons.bl. The four parameters of other stages that the
# factors of S_d and y_d read are declared as those stages declare them.

a_nxt_points : ℕ          :: ["number of points of the savings grid"]
a_nxt_min : ℝ₊            :: ["lower bound of the savings grid"]
a_nxt_max : ℝ₊            :: ["upper bound of the savings grid"]
w_points : ℕ              :: ["number of points of the cash grid"]
w_min : ℝ₊₊               :: ["lower bound of the cash grid"]
w_max : ℝ₊₊               :: ["upper bound of the cash grid"]
upper_envelope : {FUES, DCEGM, CONSAV}    :: ["the routine that removes the candidates below the upper envelope"]
c_max : ℝ₊₊               :: ["largest candidate consumption kept at the borrowing limit"]
n_constraint_points : ℕ        :: ["candidate points on the segment at the borrowing limit"]
n_constraint_points_nxt : ℕ    :: ["candidate points on a segment where the policy jumps"]
ue_kwargs : {FUES, DCEGM, CONSAV}    :: ["the options of each upper envelope routine; the set of the routines' names stands in for the mapping from each routine to its options, which the language cannot yet type"]    # no form in §4: ue_kwargs, a mapping of the three mappings FUES, DCEGM, CONSAV
tax_segments : {true, false} × [0,1] × [0,1] × ℕ    :: ["the candidate segments at the tax thresholds: whether they are added, the lower and the upper width as shares of the candidate consumption, and the number of points at each threshold, in that order"]    # no form in §4: tax_segments, a mapping with the keys enabled, c_lb_pct, c_ub_pct, n_points_per_node; the product lists their sets by position
S_min : ℝ₊                :: ["smallest quantity of rented services"]    # no form in §4: a parameter of renter_housing.bl, declared again for the factor of S_d
S_max : ℝ₊₊               :: ["largest quantity of rented services"]    # no form in §4: a parameter of renter_housing.bl, declared again for the factor of S_d
n_S   : ℕ                 :: ["number of rental quantities"]    # no form in §4: a parameter of renter_housing.bl, declared again for the factor of S_d
z     : ℝ₊₊               :: ["the income levels of the chain; ℝ₊₊ stands in for the vector, whose length the discretization of the income process fixes"]    # no form in §4: a parameter of tenure_choice.bl, declared again for the factor of y_d

[id=policy, method : !egm(upper_envelope=upper_envelope,
        ue_kwargs=ue_kwargs, c_max=c_max, n_constraint_points=n_constraint_points,
        n_constraint_points_nxt=n_constraint_points_nxt, tax_segments=tax_segments)
    | grid : !Cartesian(a_nxt_r=(a_nxt_min, a_nxt_max, a_nxt_points))] {    # no form in §4: the settings upper_envelope, ue_kwargs, c_max, n_constraint_points, n_constraint_points_nxt, tax_segments beside !egm, beyond its catalogue row; ue_kwargs and tax_segments are mappings
    c[>]   <= 𝑑𝑢𝑖𝑛𝑣(β*D_{a_nxt_r}V[>])    :: [id=InvEuler]
    w_d[>] = a_nxt_r + c[>]               :: [id=endoggrid]
    c      = c[>]                         :: [id=cons_choice]
}

[id=cntn_to_dcsn
    | evaluate.method : !Linear
    | evaluate.grid : !Cartesian(w_d=(w_min, w_max, w_points), S_d=(S_min, S_max, n_S), y_d=z)] {
    D_{w_d}V = 𝑑𝑢(c)                      :: [id=marginal]
}
