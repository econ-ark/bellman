@methods: owner_cons
# The methods of the owner's consumption stage as an addition to
# applications/housing-renting/declaration/stages/owner_cons/owner_cons.bl,
# rewritten from stages/owner_cons/methods.yml and the block files
# methods/owner_cons_egm.bl and methods/marginals_owner_cons.bl: the
# endogenous grid method on the policy builder, with the six further settings
# the YAML names beside it, two of them mappings, and its grid of the savings
# a_nxt_o as a grid entry of its own (D5, decided; writer's sheet §7); the three
# lines of owner_cons_egm.bl, the inverted Euler relation, the endogenous grid
# of cash on hand and the identification c = c[>]; the envelope line of the
# decision value from marginals_owner_cons.bl; and the linear representation of
# the decision value and of its stated derivative, each named at its own
# Evaluation, as the YAML names the two Evaluations by two entries.
#
# The three lines are written as owner_cons_egm.bl writes them (decision D8,
# decided 4 November 2026): with !egm in the slot of policy, they stand in place
# of the declared line optimality at the operative level, and stage.declared
# keeps the maximization (the proposal's §4, rule 5). The entry on
# dcsn_to_cntn, with on alone, binds nothing and is not written (writer's
# sheet §5); the README records it.
#
# The grid of each Evaluation has one factor per coordinate of the value it
# stores, V and D_{w_d}V on (w_d, H_d, y_d) (writer's sheet §7; finding F67).
# The YAML's grid names the cash alone; the housing H_d takes the n_H housing
# sizes, the triple of owner_housing.bl, and the income y_d the levels z of the
# income chain, the parameter of tenure_choice.bl.
#
# Every setting the file reads is declared with its set (writer's sheet §6): a
# bound as a point of the set the stage declares for the coordinate, ℝ₊ for the
# savings a_nxt_o and ℝ₊₊ for the cash w_d, a count in ℕ. The values stay in
# applications/housing-renting/declaration/settings/housing-renting.yml. The
# four parameters of other stages that the factors of H_d and y_d read are
# declared as those stages declare them; their values are in
# applications/housing-renting/declaration/calibration/housing-renting.yml,
# where z has none.

a_nxt_points : ℕ          :: ["number of points of the savings grid"]
a_nxt_min : ℝ₊            :: ["lower bound of the savings grid"]
a_nxt_max : ℝ₊            :: ["upper bound of the savings grid"]
w_points : ℕ              :: ["number of points of the cash grid"]
w_min : ℝ₊₊               :: ["lower bound of the cash grid"]
w_max : ℝ₊₊               :: ["upper bound of the cash grid"]
upper_envelope : {FUES, DCEGM, CONSAV}    :: ["the routine that removes the candidates below the upper envelope"]
c_max : ℝ₊₊               :: ["largest candidate consumption kept at the borrowing limit"]
n_constraint_points : ℕ        :: ["candidate points on the segment at the borrowing limit"]
n_constraint_points_nxt : ℕ    :: ["candidate points on a segment where the policy jumps"]
ue_kwargs : {FUES, DCEGM, CONSAV}    :: ["the options of each upper envelope routine; the set of the routines' names stands in for the mapping from each routine to its options, which the language cannot yet type"]    # no form in §4: ue_kwargs, a mapping of the three mappings FUES, DCEGM, CONSAV
tax_segments : {true, false} × [0,1] × [0,1] × ℕ    :: ["the candidate segments at the tax thresholds: whether they are added, the lower and the upper width as shares of the candidate consumption, and the number of points at each threshold, in that order"]    # no form in §4: tax_segments, a mapping with the keys enabled, c_lb_pct, c_ub_pct, n_points_per_node; the product lists their sets by position
H_min  : ℝ₊               :: ["smallest housing size"]    # no form in §4: a parameter of owner_housing.bl, declared again for the factor of H_d
H_max  : ℝ₊₊              :: ["largest housing size"]    # no form in §4: a parameter of owner_housing.bl, declared again for the factor of H_d
n_H    : ℕ                :: ["number of housing sizes"]    # no form in §4: a parameter of owner_housing.bl, declared again for the factor of H_d
z      : ℝ₊₊              :: ["the income levels of the chain; ℝ₊₊ stands in for the vector, whose length the discretization of the income process fixes"]    # no form in §4: a parameter of tenure_choice.bl, declared again for the factor of y_d

[id=policy, policy.method : !egm(upper_envelope=upper_envelope,
        ue_kwargs=ue_kwargs, c_max=c_max, n_constraint_points=n_constraint_points,
        n_constraint_points_nxt=n_constraint_points_nxt, tax_segments=tax_segments)
    | policy.grid : !Cartesian(a_nxt_o=(a_nxt_min, a_nxt_max, a_nxt_points))] {    # no form in §4: the settings upper_envelope, ue_kwargs, c_max, n_constraint_points, n_constraint_points_nxt, tax_segments beside !egm, beyond its catalogue row; ue_kwargs and tax_segments are mappings
    c[>]   <= 𝑑𝑢𝑖𝑛𝑣(β*D_{a_nxt_o}V[>])    :: [id=InvEuler]
    w_d[>] = a_nxt_o + c[>]               :: [id=endoggrid]
    c      = c[>]                         :: [id=cons_choice]
}

[id=cntn_to_dcsn
    | evaluate[V].method : !Linear
    | evaluate[V].grid : !Cartesian(w_d=(w_min, w_max, w_points), H_d=(H_min, H_max, n_H), y_d=z)
    | evaluate[D_{w_d}V].method : !Linear
    | evaluate[D_{w_d}V].grid : !Cartesian(w_d=(w_min, w_max, w_points), H_d=(H_min, H_max, n_H), y_d=z)] {
    D_{w_d}V = 𝑑𝑢(c)                      :: [id=marginal]
}
