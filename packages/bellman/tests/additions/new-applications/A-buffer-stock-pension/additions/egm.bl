@methods: buffer_stock
# The endogenous grid method on the policy builder of the unioned stage, read
# after pension.bl at every occurrence but the last. The method's grid is its
# own typing entry beside the method word (D5, AAS, 4 November 2026; sheet
# §7): one factor per coordinate of the continuation perch, the exogenous
# savings grid and the carried-balance grid, since the candidate line is read
# at each pair (a, q); the consumption function c(m, p_d) is read between the
# candidate pairs by linear interpolation at the policy builder's Evaluation,
# which writes no grid entry, its knots being the pairs the method stores
# (F74). The three lines are those of buffer_stock_egm.bl, written as the
# block file writes them: since the block's slot holds a solution method, the
# elaborator reads them at the operative level in place of the declared
# maximization, which stage.declared keeps (D8, AAS, 4 November 2026;
# proposal §4 rule 5). The set Xp of the balance is declared by pension.bl,
# which precedes this file.

n_a : ℕ              :: ["number of points of the savings grid"]
a_min : Xa           :: ["lower bound of the savings grid"]
a_max : Xa           :: ["upper bound of the savings grid"]
n_q : ℕ              :: ["number of points of the carried-balance grid"]
q_min : Xp           :: ["lower bound of the carried-balance grid"]
q_max : Xp           :: ["upper bound of the carried-balance grid"]

[id=policy, policy.method : !egm | policy.grid : !Cartesian(a=(a_min, a_max, n_a), q=(q_min, q_max, n_q))
    | evaluate.method : !Linear] {
    c[>] = 𝑑𝑢𝑖𝑛𝑣(β*D_{a}V[>])                        :: [id=InvEuler]
    m[>] = a + c[>]                                  :: [id=g_cntn_to_dcsn]
    c[~] = c[>]                                      :: [id=cons_choice]
}
