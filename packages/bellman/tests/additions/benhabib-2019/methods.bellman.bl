@methods: bellman
# The methods of the within-life stage `bellman`, whose stage file is
# applications/benhabib-2019/declaration/stages/benhabib_bellman/benhabib_bellman.bl,
# as an addition to that file: the endogenous grid method on the policy
# builder with its grid of savings, a typing entry of its own (D5, decided),
# and the legacy's placeholder handler as the handler binding of the place
# (sheet §5), the
# two candidate lines of the method, the inverted Euler equation and the
# inverted law of motion, each marked !node as the block file marked it, and
# the envelope line of the decision value builder. The block file's third
# line, c = c[>], is written as the block file writes it: under D8
# (decided), the lines of a block whose slot holds a solution method stand in
# place of the declared lines at the operative level, and stage.declared
# keeps the stage file's maximization.
# The three settings the grid's factor reads are declared with their domains (writer's
# sheet §6): the bounds as points of Xa, the set of the savings a, and the
# count in ℕ; their values stay in settings/default.yml.

n_a : ℕ        :: ["number of points of the savings grid"]
a_min : Xa     :: ["lower bound of the savings grid"]
a_max : Xa     :: ["upper bound of the savings grid"]

[id=policy, method : !egm | handler : "dolo:egm_backward"
    | grid : !Cartesian(a=(a_min, a_max, n_a))] {    # no form in §4: handler: dolo:egm_backward, beside !egm
    c[>] = (β * R_vec[r_type] * D_{a}V[>])^(-1/σ)        :: [id=InvEuler, !node]    # no form in §4: !node on a line of the block file benhabib_bellman_egm.bl
    m[>] = c[>] + (a - wage_fn[tau]) / R_vec[r_type]     :: [id=inv_g_dcsn_to_cntn, !node]    # no form in §4: !node on a line of the block file benhabib_bellman_egm.bl
    c    = c[>]                                          :: [id=cons_choice]
}

[id=cntn_to_dcsn] {
    D_{m}V = c^(-σ)                    :: [id=marginal]
}
