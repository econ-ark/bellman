@methods: bellman
# Deliberate refusals on the within-life stage `bellman`, whose stage file is
# applications/benhabib-2019/declaration/stages/benhabib_bellman/benhabib_bellman.bl.
# No block of this file belongs to the application's methods; each is written
# as an author might write it by mistake. The comment above each block says
# why the package refuses the union of that block with the stage file, and
# names the refusal rule.

n_a : ℕ        :: ["number of points of the savings grid"]
a_min : Xa     :: ["lower bound of the savings grid"]
a_max : Xa     :: ["upper bound of the savings grid"]

# Refused: one component written twice. The relative path `method` and the
# absolute path `policy.method` name one component, the method of the block
# policy, since a path inside a block's bracket is read relative to the block,
# and they give it two different methods. A component holds one entry over the
# files of a stage, so the package refuses the second entry and names both
# (`declared-twice`).
[id=policy, method : !egm, policy.method : !vfi
    | grid : !Cartesian(a=(a_min, a_max, n_a))] {
    c[>] = (β * R_vec[r_type] * D_{a}V[>])^(-1/σ)        :: [id=InvEuler, !node]
    c    = c[>]                                          :: [id=cons_choice]
}

# Refused for two reasons. First, two sets on one coordinate: the signature
# that the block writes gives the control c the set ℝ₊₊, where the stage's
# signature of dcsn_to_cntn gives it ℝ₊, and a coordinate keeps the stage's
# set (`type-conflict`). Second, one line id twice: the line restates the
# stage's law of motion under its id `savings`, which the stage's block
# already holds (`declared-twice`).
[id=dcsn_to_cntn, (c : !ctrl @ ℝ₊₊) : !dcsn -> ()] {
    a = R_vec[r_type] * (m - c) + wage_fn[tau]    :: [id=savings]
}

# Refused: a path that names another block. The path of the entry begins with
# `policy`, a block other than the enclosing cntn_to_dcsn, so it would type the
# representation of the policy builder's Evaluation from inside the decision
# builder (`label-not-in-parent`). The derivative line is the one that the
# application's methods file adds.
[id=cntn_to_dcsn
    | policy.evaluate.method : !Linear] {
    D_{m}V = c^(-σ)                    :: [id=marginal]
}
