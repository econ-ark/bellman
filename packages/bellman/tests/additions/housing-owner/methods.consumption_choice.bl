@methods: consumption_choice
# The methods of the owner's consumption-choice stage as an addition to
# applications/housing-owner/declaration/stages/consumption_choice/consumption_choice.bl,
# rewritten from stages/consumption_choice/methods.yml and the block files
# methods/consumption_choice_egm.bl and methods/marginals_consumption_choice.bl:
# the endogenous grid method on the policy builder with its grid of savings
# as the grid entry of the place (D5, decided; writer's sheet §7),
# the two candidate lines of consumption_choice_egm.bl appended with their
# marks !node, the identification line c = c[>], and the envelope line of the
# decision value builder. The three lines of consumption_choice_egm.bl are
# written as the block file writes them: with !egm in the slot of policy, they
# stand in place of the declared line optimality at the operative level, and
# stage.declared keeps the maximization (proposal §4 rule 5, D8, decided).
# The blocks of the two block files, there named egm and dcsn_marginal, are
# named here by the builders' ids; their signatures add no coordinate and are
# not restated (sheet §1).
# The grid entry names the coordinate it discretizes, a_nxt, as the YAML's
# orders: {a_nxt: n_a} did; it writes no factor for the other two coordinates
# of the continuation perch, H_c in XH and y_c in Y, which the YAML leaves out.
# Every setting the grid reads is declared with its set, the bounds as points
# of Xa, the set the stage declares for a_nxt (sheet §6).
# The stage file is refused by the elaborator today at its definition
# XH := linspace(H_min, H_max, n_H), rule not-constructed (sheet §4.5).

n_a : ℕ        :: ["number of points of the savings grid"]
a_min : Xa     :: ["lower bound of the savings grid"]
a_max : Xa     :: ["upper bound of the savings grid"]

[id=policy, policy.method : !egm | policy.grid : !Cartesian(a_nxt=(a_min, a_max, n_a))] {
    c[>] = (β*D_{a_nxt}V[>] / (θ * (κ*H_c + ι)^((1-θ)*(1-γ))))^(1/(θ*(1-γ) - 1))  :: [id=InvEuler, !node]
    w[>] = a_nxt + c[>]                                                             :: [id=regrid, !node]
    c    = c[>]                                                                     :: [id=cons_choice]
}

[id=cntn_to_dcsn] {
    D_{w_d}V = θ * c^(θ*(1-γ)-1) * (κ*H_d + ι)^((1-θ)*(1-γ))      :: [id=marginal]
}
