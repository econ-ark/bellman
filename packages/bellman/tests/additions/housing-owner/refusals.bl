@methods: consumption_choice
# Deliberate refusals on the owner's consumption-choice stage, whose stage
# file is
# applications/housing-owner/declaration/stages/consumption_choice/consumption_choice.bl.
# No item of this file belongs to the application's methods; each is written
# as an author might write it by mistake. The comment above each item says why
# the package refuses the union of that item with the stage file, and names
# the refusal rule. The settings that the two grid entries read are declared
# with their sets; each grid is an entry of its own at its place. The stage
# file alone is refused as well (`not-constructed`, at its definition XH).

n_a : ℕ        :: ["number of points of the savings grid"]
a_min : Xa     :: ["lower bound of the savings grid"]
a_max : Xa     :: ["upper bound of the savings grid"]
n_w : ℕ        :: ["number of points of the grid of cash on hand"]
w_min : Xw     :: ["lower bound of the grid of cash on hand"]
w_max : Xw     :: ["upper bound of the grid of cash on hand"]

# Refused: one component written twice, by a line at file level and by a
# bracket. The package attaches the line policy.method to the block policy,
# whose bracket below gives the same component, by the relative path method,
# the endogenous grid method. A component holds one entry over the files of a
# stage, so the package refuses the second entry and names both
# (`declared-twice`).
policy.method : !vfi

# Refused: two paths that name another block. The paths of the last two
# entries begin with cntn_to_dcsn, a block other than the enclosing policy, so
# they would type the representation of the derivative of the decision value
# and its grid from inside the policy builder (`label-not-in-parent`); naming
# one stored object of an Evaluation does not change the block a path names.
[id=policy, method : !egm | policy.grid : !Cartesian(a_nxt=(a_min, a_max, n_a))
    | cntn_to_dcsn.evaluate[D_{w_d}V].method : !Linear
    | cntn_to_dcsn.evaluate[D_{w_d}V].grid : !Cartesian(w_d=(w_min, w_max, n_w))] {
    c[>] = (β*D_{a_nxt}V[>] / (θ * (κ*H_c + ι)^((1-θ)*(1-γ))))^(1/(θ*(1-γ) - 1))  :: [id=InvEuler, !node]
    w[>] = a_nxt + c[>]                                                             :: [id=regrid, !node]
}

# Refused for two reasons. First, two sets on one coordinate: the signature
# that the block writes appends the decision value V with the set ℝ₊, where
# the stage's signature of cntn_to_dcsn gives it ℝ, and the value of the
# aggregate is negative when γ > 1 (`type-conflict`; the empty domain () adds
# nothing). Second, one line id twice: the envelope line is written under the
# id value, which the stage's line of the decision value already carries in
# this block (`declared-twice`).
[id=cntn_to_dcsn, () -> (V : ℝ₊ @ !vlu) : !dcsn] {
    D_{w_d}V = θ * c^(θ*(1-γ)-1) * (κ*H_d + ι)^((1-θ)*(1-γ))      :: [id=value]
}
