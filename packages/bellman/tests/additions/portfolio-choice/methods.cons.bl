@methods: cons
# The methods of the consumption stage as an addition to
# applications/portfolio-choice/declaration/stages/cons/cons.bl, rewritten from
# stages/cons/methods.yml and the block file methods/cons_egm.bl: the
# endogenous grid method on the policy builder, with its grid of savings and the
# function egm of cons-port as its handler; the two candidate lines of
# cons_egm.bl, the inverted Euler equation with its Kuhn-Tucker clause and the
# inverted law of motion, and its identification line c = c[>]; one linear
# representation of the decision value and of its stated derivative on the
# grid of resources, for the YAML's two equal entries; the deterministic
# arrival builder; and the handler of the forward decision builder, which the
# YAML names with no method. The three lines of
# cons_egm.bl are written as the block file writes them: with the solution
# method !egm in the slot of policy, they stand in place of the declared
# maximization at the operative level, and stage.declared keeps the
# maximization of cons.bl (D8, decided; rule 5). The entry on dcsn_to_arvl,
# which binds nothing, is not written (sheet §5). The block of cons_egm.bl
# carries a signature equal to the stage's; it is not restated, since a
# methods-file block that adds no coordinate carries no signature (sheet §1).
# The selections that add no line are file-level lines routed by their paths
# (rule 7), since an empty body is refused.
# Each grid is its own typing entry at its place, one factor per coordinate
# keyed by the coordinate's name (writer's sheet §7; D5, decided). Every setting
# a grid reads is declared above the blocks and lines with its set, a bound as a
# point of the set its coordinate is declared on, a count in ℕ (sheet §6).

𝑑𝑢𝑖𝑛𝑣(x : ℝ₊₊) := x^(-1/ρ)

n_a : ℕ        :: ["number of points of the savings grid"]
a_min : Xa     :: ["lower bound of the savings grid"]
a_max : Xa     :: ["upper bound of the savings grid"]
n_m : ℕ        :: ["number of points of the grid of resources"]
m_min : Xm     :: ["lower bound of the grid of resources"]
m_max : Xm     :: ["upper bound of the grid of resources"]

[id=policy, method : !egm | grid : !Cartesian(a=(a_min, a_max, n_a)) | handler : "cons-port:egm"] {    # no form in §4: handler: cons-port:egm
    c[>]   <= 𝑑𝑢𝑖𝑛𝑣(D_{a}V[>]) ⟂ a >= 0    :: [id=InvEuler]
    m_d[>] = a + c[>]                        :: [id=grid]
    c      = c[>]                            :: [id=identification]
}

cntn_to_dcsn.evaluate.method : !Linear    # no form in §4: handler: cons-port:_make_interp, on each of the entries cntn_to_dcsn.evaluate.value and cntn_to_dcsn.evaluate.marginal
cntn_to_dcsn.evaluate.grid : !Cartesian(m_d=(m_min, m_max, n_m))
cntn_to_dcsn.evaluate.handler : "cons-port:_make_interp"
arvl_to_dcsn.method : !deterministic
dcsn_to_cntn.handler : "cons-port:transition_fwd"
