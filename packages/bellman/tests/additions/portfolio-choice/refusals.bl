@methods: cons
# Deliberate refusals on the consumption stage, whose stage file is
# applications/portfolio-choice/declaration/stages/cons/cons.bl. No block of
# this file belongs to the application's methods; each is written as an author
# might write it by mistake. The comment above each block says why the package
# refuses the union of that block with the stage file, and names the refusal
# rule. The inverse marginal utility is written inline in the candidate line,
# (D_{a}V[>])^(-1/ρ), so that the file adds no function definition. The
# settings that the two grid entries read are declared with their sets, so
# that only the deliberate refusals are reported.

n_a : ℕ        :: ["number of points of the savings grid"]
a_min : Xa     :: ["lower bound of the savings grid"]
a_max : Xa     :: ["upper bound of the savings grid"]
n_m : ℕ        :: ["number of points of the grid of resources"]
m_min : Xm     :: ["lower bound of the grid of resources"]
m_max : Xm     :: ["upper bound of the grid of resources"]

# Refused for two reasons. First, one component written twice: the relative
# path `grid` and the absolute path `policy.grid` name one component, the grid
# of the block policy, since a path inside a block's bracket is read relative
# to the block, and they type it with two different grids on the savings a,
# the second built from the settings of the grid of resources. The package
# refuses the second entry and names both (`declared-twice`). Second, a path
# that names another block: the entry places the representation of the
# decision value in the one block of the file that has a body, and its path
# begins with cntn_to_dcsn, a block other than the enclosing policy
# (`label-not-in-parent`).
[id=policy, method : !egm
    | grid : !Cartesian(a=(a_min, a_max, n_a))
    | policy.grid : !Cartesian(a=(m_min, m_max, n_m))
    | handler : "cons-port:egm"
    | cntn_to_dcsn.evaluate.method : !Linear] {
    c[>]   <= (D_{a}V[>])^(-1/ρ) ⟂ a >= 0    :: [id=InvEuler]
    m_d[>] = a + c[>]                        :: [id=grid]
}

# Refused for two reasons. First, two sets on one coordinate: the signature
# that the block writes gives the decision value V the set ℝ, as noport.bl,
# port.bl and disc.bl type their decision values, where cons.bl gives it
# [-inf, inf) (`type-conflict`; the empty domain () adds nothing). Second, one
# line id twice: the line restates the envelope condition under its id
# marginal, which cons.bl already writes in this block (`declared-twice`); the
# buffer-stock methods file writes such a line because its stage file states
# no derivative, and this stage file states one.
[id=cntn_to_dcsn, () -> (V : ℝ @ !vlu) : !dcsn] {
    D_{m_d}V = 𝑑𝑢(c)                :: [id=marginal]
}
