@methods: ret_choice
# Deliberate refusals on the branching stage ret_choice, whose stage file is
# applications/retirement-choice/declaration/stages/ret_choice/ret_choice.bl.
# No item of this file belongs to the application's methods; each is written
# as an author might write it by mistake. The comment above each item says why
# the package refuses the union of that item with the stage file, and names
# the refusal rule. The third block is a nested block with a label, which
# merges with the stage's branch of the same label under its parent block,
# the branching block dcsn_to_cntn.

n_a : ℕ              :: ["number of points of the asset grid"]
a_min : ℝ₊           :: ["lower bound of the asset grid"]
a_max : ℝ₊           :: ["upper bound of the asset grid"]

# Refused: one component written twice. The package attaches the two lines
# policy.method at file level to the block policy, and they give its method
# two different words, the discrete maximum with its handler and the other
# method word for a discrete choice. A component holds one entry over the
# files of a stage, so the package refuses the second entry and names both
# (`declared-twice`).
policy.method : !max
policy.handler : "fues-retirement:dcsn_mover"
policy.method : !discrete_choice

# Refused for two reasons. First, two paths that name another block: the
# paths of the two entries begin with policy, a block other than the
# enclosing dcsn_to_arvl, so they would type the representation of the policy
# builder's Evaluation and its grid from inside the arrival builder
# (`label-not-in-parent`). Second, one line id twice: the line D_{a}V[<] =
# D_{a_d}V, which follows from the law a_d = a, takes the id value, which the
# stage's line V[<] = V already holds (`declared-twice`).
[id=dcsn_to_arvl
    | policy.evaluate.method : !Linear
    | policy.evaluate.grid : !Cartesian(a_d=(a_min, a_max, n_a))] {
    D_{a}V[<] = D_{a_d}V                        :: [id=value]
}

# Refused: two sets on one coordinate, on a nested block with a label. The
# author restates the work branch of the branching block dcsn_to_cntn to
# narrow the set of the continuation assets a_w to ℝ₊₊, where the stage's
# branch gives ℝ₊, and copies the branch's line, since a body may not be
# empty. The nested block merges with the stage's branch of the same label
# under its parent, and its coordinate a_w keeps the stage's set
# (`type-conflict`). The copied line, which carries no id, would define a_w a
# second time in the branch, which the package refuses as well
# (`defined-once`).
[id=dcsn_to_cntn] {
    [label=work, () -> (a_w : ℝ₊₊) : !cntn] { a_w = a_d }
}
