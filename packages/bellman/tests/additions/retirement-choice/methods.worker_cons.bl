@methods: worker_cons
# The methods of the worker's consumption stage as an addition to
# applications/retirement-choice/declaration/stages/worker_cons/worker_cons.bl:
# the endogenous grid method on the policy builder with its grid of savings and
# its handler, the four lines of worker_cons_egm.bl as that file writes them
# (the inverted Euler relation, the endogenous grid of cash on hand, the
# candidate value and the upper envelope that gives c from the candidates),
# FUES on the operator upper_env of the last of them with its threshold m_bar,
# the envelope line of the decision value and the derivative line of the
# arrival value from marginals_worker_cons.bl, and one linear representation of the arrival value
# and of its stated derivative on the asset grid. The four settings the file
# reads are declared at the top (the writer's sheet §6). Each grid is its own
# typing entry at its place, one factor keyed by its coordinate (D5, decided
# by AAS on 4 November 2026; the sheet's §7): the savings b, the continuation
# state on which !egm builds its grid and which the policy builder's signature
# does not list, and the assets a_w at the arrival builder's Evaluation, both
# on the bounds and the count of the settings file's asset grid.
#
# With the solution method !egm in the slot of policy, the four lines stand in
# place of the declared maximization at the operative level, and
# stage.declared keeps the stage file's line (proposal §4, rule 5; D8,
# decided by AAS on 4 November 2026), so the line envelope, which defines c,
# meets no second definition, and the group on upper_env names the operator of
# that line.

n_a : ℕ              :: ["number of points of the asset grid"]
a_min : Xa           :: ["lower bound of the asset grid"]
a_max : Xa           :: ["upper bound of the asset grid"]
m_bar : ℝ₊₊          :: ["jump-detection threshold of the upper envelope scan"]

[id=policy, method : !egm | grid : !Cartesian(b=(a_min, a_max, n_a)) | handler : "asva:make_egm_1d"
    | upper_env.method : !FUES(m_bar=m_bar) | upper_env.handler : "dcsmm:EGM_UE"] {    # no form in §4: handler: asva:make_egm_1d beside !egm; on: upper_env, the stage-wide address of an operator of the block file's line envelope; handler: dcsmm:EGM_UE and settings m_bar beside !FUES, whose catalogue row admits no option
    c[>] <= 𝑑𝑢𝑖𝑛𝑣(β*D_{b}V[>])                 :: [id=InvEuler]
    w[>] = b + c[>]                            :: [id=endoggrid]
    v[>] = 𝑢(c[>]) + β*V[>]                    :: [id=cand_value]
    c    = upper_env(w[>], c[>], v[>])          :: [id=envelope]
}

[id=cntn_to_dcsn] {
    D_{w}V = 𝑑𝑢(c)                  :: [id=marginal]
}

[id=dcsn_to_arvl
    | evaluate.method : !Linear | evaluate.grid : !Cartesian(a_w=(a_min, a_max, n_a)) | evaluate.handler : "dcsmm:interp_as_2"] {    # no form in §4: handler: dcsmm:interp_as_2 beside !Linear, on the two entries dcsn_to_arvl.evaluate.value and dcsn_to_arvl.evaluate.marginal
    D_{a_w}V[<] = R*D_{w}V          :: [id=marginal]
}
