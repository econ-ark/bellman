@methods: ret_choice
# The methods of the choice between work and retirement as an addition to
# applications/retirement-choice/declaration/stages/ret_choice/ret_choice.bl:
# the discrete maximum on the policy builder with the handler of the FUES
# retirement example that compares the two branch values, and the derivative
# of the choice value in assets, the derivative of the branch value the choice
# d selects, as an authored line of the decision value builder, from
# marginals_ret_choice.bl. The policy builder gains no line, and a block of a
# methods file may not have an empty body, so its method is a file-level line
# routed by its path to the block policy (rule 7). The branching block
# dcsn_to_cntn, whose two nested blocks are labeled work and retire, takes
# nothing: the union keeps it as the stage file writes it (rule 3).

policy.method : !max    # no form in §4: handler: fues-retirement:dcsn_mover beside !max, on the policy builder of a branching stage
policy.handler : "fues-retirement:dcsn_mover"

[id=cntn_to_dcsn] {
    D_{a_d}V = (D_{a_w}V_w[>], D_{a_r}V_r[>])[d]  :: [id=marginal]
}
