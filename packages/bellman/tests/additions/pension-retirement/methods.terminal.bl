@methods: terminal
# The methods of the terminal stage as an addition to
# applications/pension-retirement/declaration/stages/terminal/terminal.bl:
# the derivatives of the terminal value in the two assets, zero, as authored
# lines of the arrival value builder, from the block arvl_marginal of
# marginals_terminal.bl. That block's signature, () : !dcsn -> (V[<]) : !arvl,
# is not restated: its empty input side adds nothing under rule 4 and its
# output V[<] is the stage's, so it adds no coordinate, and a block of a
# methods file that adds no coordinate carries no signature (the writer's
# sheet §1). The stage takes no method: its values are closed forms.

[id=dcsn_to_arvl] {
    D_{y_f_T}V[<] = 0                                 :: [id=marginal_financial]
    D_{y_p_T}V[<] = 0                                 :: [id=marginal_pension]
}
