@methods: retiree_saving
# The methods of the retiree's saving stage as an addition to
# applications/pension-retirement/declaration/stages/retiree_saving/retiree_saving.bl:
# time iteration on the policy builder, written by the relative subject
# method, with the Euler equation of consumption of retiree_saving_foc.bl and
# its complementarity clause appended as its line; the envelope line of the
# decision value and the two derivative lines of the arrival value, which
# keep the factors 1 + r_f and 1 + r_p of the law of m_r, from the two blocks
# of marginals_retiree_saving.bl. The block ids foc, dcsn_marginal and
# arvl_marginal become the builders' ids policy, cntn_to_dcsn and
# dcsn_to_arvl. The YAML file binds no representation and no setting.
#
# The YAML gives !time-iteration no grid. Under D5 (AAS, 4 November 2026;
# the writer's sheet §7) the policy builder's grid is its own typing entry,
# written by the relative subject grid: the decision grid on which the Euler
# relation is solved, one factor for the one state coordinate m_r of the
# decision perch (F40). Its three settings are declared with their domains
# (the sheet §6) and are valued in no file, since the application has no
# settings file.

n_m_r : ℕ            :: ["number of points of the grid of resources"]
m_r_min : ℝ₊₊        :: ["lower bound of the grid of resources"]
m_r_max : ℝ₊₊        :: ["upper bound of the grid of resources"]

[id=policy, method : !time_iteration
    | grid : !Cartesian(m_r=(m_r_min, m_r_max, n_m_r))] {    # the YAML named no grid for !time-iteration; the decision grid is written as D5 directs (F40)
    𝑑𝑢(c) = β*D_{y_f_ret}V[>] ⟂ m_r - c >= 0           :: [id=euler_financial]
}

[id=cntn_to_dcsn] {
    D_{m_r}V = 𝑑𝑢(c)                                  :: [id=marginal]
}

[id=dcsn_to_arvl] {
    D_{y_f_r}V[<] = (1 + r_f)*D_{m_r}V                :: [id=marginal_financial]
    D_{y_p_r}V[<] = (1 + r_p)*D_{m_r}V                :: [id=marginal_pension]
}
