@methods: terminal
# The methods of the terminal stage as an addition to
# applications/housing-frictions/declaration/stages/terminal/terminal.bl,
# rewritten from stages/terminal/methods.yml and the block file
# methods/marginals_terminal.bl: the two derivatives of the terminal decision
# value, zero, appended to the decision value builder under the builder's id,
# in place of the block file's id dcsn_marginal (writer's sheet §5). The block
# keeps the block file's partial signature, () : !cntn -> (V) : !dcsn, whose
# empty domain adds nothing and whose codomain names the one output the stage
# already declares, so that the union of the two signatures is the stage's
# (rule 4, finding F16); a methods-file block that adds no coordinate may
# carry no signature (sheet §1), and this one keeps it to exercise the empty
# side. The entry introduced by a comment beginning "Addition" is no part of
# the application's selection: it is written to exercise an aspect of the
# writer's sheet at a place the stage has, and the YAML binds nothing there.

# Addition: the arrival builder copies y_f_T and y_h_T to the decision states,
# so the measure it carries is unchanged; a representation of a forward
# builder's measure without a grid, as a file-level line routed by its path.
arvl_to_dcsn.method : !identity

# The two derivatives of the terminal decision value, zero, the continuation
# value being the zero boundary data.
[id=cntn_to_dcsn, () : !cntn -> (V) : !dcsn] {
    D_{y_f_d}V = 0                                      :: [id=marginal_financial]
    D_{y_h_d}V = 0                                      :: [id=marginal_housing]
}
