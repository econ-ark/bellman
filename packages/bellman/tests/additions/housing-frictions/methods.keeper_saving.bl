@methods: keeper_saving
# The methods of the keeper's saving stage as an addition to
# applications/housing-frictions/declaration/stages/keeper_saving/keeper_saving.bl,
# rewritten from stages/keeper_saving/methods.yml and the block file
# methods/marginals_keeper_saving.bl: the derivatives of the decision value in
# cash on hand and in housing, appended to the decision value builder under
# the builder's id, in place of the block file's id dcsn_marginal (writer's
# sheet §5). The block keeps the block file's signature, (V[>], c) -> (V) :
# !dcsn, whose three coordinates are the stage's own, so that the union merges
# each with the stage's coordinate of the same name and adds none (rule 4,
# finding F16); a methods-file block that adds no coordinate may carry no
# signature (sheet §1), and this one keeps it to exercise the merge. Every
# entry introduced by a comment beginning "Addition" is no part of the
# application's selection: it is written to exercise an aspect of the
# writer's sheet at a place the stage has, and the YAML binds nothing there.
# The stage file's Euler line euler_financial stands in its policy block
# beside the maximization, which it marks !doc, with no method word; nothing
# is added to that block (sheet §5, finding F14).

# Addition: the settings that the grid entries below read, declared with their sets (writer's
# sheet §6): the bounds are points of ℝ₊₊, the set the stage gives cash on
# hand m_d and the housing h_d, and the counts are in ℕ. The application has
# no settings file.
n_m : ℕ          :: ["number of points of the grid of cash on hand"]
m_min : ℝ₊₊      :: ["lower bound of the grid of cash on hand"]
m_max : ℝ₊₊      :: ["upper bound of the grid of cash on hand"]
n_h : ℕ          :: ["number of points of the grid of housing"]
h_min : ℝ₊₊      :: ["lower bound of the grid of housing"]
h_max : ℝ₊₊      :: ["upper bound of the grid of housing"]

# Addition: time iteration on the policy builder, whose operative line is the
# Euler relation euler_financial with its Kuhn-Tucker clause and whose
# maximization the stage file marks !doc, so that a method says how the
# relation is solved for c at each point of the grid of the two decision
# states (finding F69), the grid its own typing entry with one factor per
# coordinate, cash on hand m_d and housing h_d, keyed by the coordinate's name
# (D5, writer's sheet §7); file-level lines, since no line is added to the
# block and an empty body is refused.
policy.method : !time_iteration
policy.grid : !Cartesian(m_d=(m_min, m_max, n_m), h_d=(h_min, h_max, n_h))

# Addition: the inverse of the marginal utility of consumption in closed form,
# at the definition 𝑢_c(c) := c^(-ρ) of the stage file, by which the Euler
# line 𝑢_c(c) = β*D_{y_f_kp}V[>] is solved for c; a file-level line, routed
# by its path to the definition. The word is no representation, so the
# definition takes no grid entry.
𝑢_c.method : !analytic_inverse    # no form in §4: a method at a definition; the YAML binds none, sheet §5, F13

# The derivatives of the decision value. Addition: one linear representation
# of the decision value and of its two stated derivatives, by the unrefined
# Evaluation slot (D4, finding F6), on the grid of the two decision states,
# written by its own entry (writer's sheet §7).
[id=cntn_to_dcsn, (V[>], c) -> (V) : !dcsn
    | evaluate.method : !Linear
    | evaluate.grid : !Cartesian(m_d=(m_min, m_max, n_m), h_d=(h_min, h_max, n_h))] {
    D_{m_d}V = 𝑢_c(c)                                   :: [id=marginal_cash]
    D_{h_d}V = 𝑢_h(h_d) + β*D_{y_h_kp}V[>]              :: [id=marginal_housing]
}
