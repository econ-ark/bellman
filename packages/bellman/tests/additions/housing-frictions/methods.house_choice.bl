@methods: house_choice
# The methods of the choice of keeping or adjusting the house as an addition
# to applications/housing-frictions/declaration/stages/house_choice/house_choice.bl,
# rewritten from stages/house_choice/methods.yml and the block file
# methods/marginals_house_choice.bl: the derivatives of the decision value as
# those of the branch that the choice d selects, appended to the decision
# value builder, and the derivatives of the arrival value with the factors of
# the laws of financial assets and housing, appended to the arrival value
# builder. The block file's two blocks, dcsn_marginal and arvl_marginal,
# chosen by their signatures, are named by the builders' ids, and their line
# ids marginal_financial and marginal_housing, written in both, stay, since
# line ids are per block (writer's sheet §5). Their signatures equal the
# stage's and are not restated (sheet §1). Every entry introduced by a comment
# beginning "Addition" is no part of the application's selection: it is
# written to exercise an aspect of the writer's sheet at a place the stage
# has, and the YAML binds nothing there. The stage is branching, and
# stage.places() refuses it today; the checker reads its places from the
# elaborator's message.

# Addition: the settings that the grid entry below reads, declared with their sets (writer's
# sheet §6): the bounds of the financial assets are points of ℝ₊ and those of
# the housing points of ℝ₊₊, the sets the stage gives y_f and y_h; the counts
# are in ℕ. The application has no settings file.
n_y_f : ℕ        :: ["number of points of the grid of financial assets"]
y_f_min : ℝ₊     :: ["lower bound of the grid of financial assets"]
y_f_max : ℝ₊     :: ["upper bound of the grid of financial assets"]
n_y_h : ℕ        :: ["number of points of the grid of housing"]
y_h_min : ℝ₊₊    :: ["lower bound of the grid of housing"]
y_h_max : ℝ₊₊    :: ["upper bound of the grid of housing"]

# Addition: the discrete maximum over keeping and adjusting on the policy
# builder; a file-level line routed by its path, since no line is added to
# the block and an empty body is refused.
policy.method : !max

# Addition: the deterministic transition of the decision builder, whose body
# is the two labeled branches keep and adjust.
dcsn_to_cntn.method : !deterministic    # no form in §4: the method slot of a block whose body is two labeled branches; the YAML binds none, F12

# The derivatives of the decision value, each the derivative of the value of
# the branch that d selects; an adjuster's housing is sold at its value, so
# its derivative in housing is the adjuster's derivative in total resources.
[id=cntn_to_dcsn] {    # no form in §4: the block dcsn_marginal of marginals_house_choice.bl, chosen by its signature, with the line ids marginal_financial and marginal_housing also written in arvl_marginal
    D_{m_f}V = (D_{w_kp}V_kp[>], D_{w_adj}V_adj[>])[d]  :: [id=marginal_financial]
    D_{m_h}V = (D_{h_kp}V_kp[>], D_{w_adj}V_adj[>])[d]  :: [id=marginal_housing]
}

# The derivatives of the arrival value. Addition: the expectation over the
# two-point law of η as the probability-weighted sum of the two values, at
# every occurrence of the operator in the block, the stage's line value and
# the two lines appended here; and one linear representation of the arrival
# value and of its two stated derivatives, by the unrefined Evaluation slot
# (D4, finding F6), on the grid of the two arrival states, financial assets
# y_f and housing y_h, written by its own entry with one factor per
# coordinate (D5, writer's sheet §7).
[id=dcsn_to_arvl
    | E_η.method : !sum
    | evaluate.method : !Linear
    | evaluate.grid : !Cartesian(y_f=(y_f_min, y_f_max, n_y_f), y_h=(y_h_min, y_h_max, n_y_h))] {    # no form in §4: the block arvl_marginal of marginals_house_choice.bl, chosen by its signature, with the line ids of dcsn_marginal
    D_{y_f}V[<] = E_{η}((1 + r)*D_{m_f}V)               :: [id=marginal_financial]
    D_{y_h}V[<] = E_{η}(D_{m_h}V)                       :: [id=marginal_housing]
}
