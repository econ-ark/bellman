-- stage.asdl — the stage additions (typing) to the core.
-- Commentary: spec_0.3-dynsym.md §3.2.

entry     += Typer(typer typing)              -- the attachment
index     += At(perch)                        -- placement open
expr      += Space(setexpr set)               -- injection
stmt      += CorrDef(identifier name, coordinate* params,
                     setexpr body)            -- Γ(x) := {…}
stmt      += Slack(stmt core, cond bound)     -- core ⟂ bound: complementary
                                              -- slackness; the bound is held
                                              -- and checked by nothing
subscript += In(identifier var, expr set)     -- c ∈ Γ(m)

typer = Declaration(subject subject, classifier* classifiers,
                    expr? value)
      | Marked(mark kind)
      | Signature(subject source, classifier* source_types,
                  subject target, classifier* target_types)
      | Complementary(typer declaration, cond bound)  -- a declared multiplier with its
                                              -- clause, μ[>] : ℝ₊ ⟂ a >= 0

subject    = Subject(coordinate* coordinates)
coordinate = Coordinate(identifier stem, index? at,
                        classifier* classifiers)
           | Group(subject inner, classifier* classifiers)

law_stmt   = Law(identifier* subjects, expr law)
funcdef    = FuncDef(identifier name, coordinate* params, expr body)

classifier = Domain(setexpr space)
           | Infoset(perch side)
           | Role(role kind)

perch = Arrival | Decision | Continuation
role  = State | Control | Value(int order)    -- @value 0, @marginal 1
      | Shock -- @dist N(μ, Σ)
      | Parameter
mark  = Node                                  -- Method later

setexpr = Named(identifier name)
        | Interval(range bounds)
        | FiniteSet(identifier* members)
        | Product(setexpr* factors)
        | Comprehension(subject bound, setexpr? base,
                        cond* conds)          -- { c ∈ B : … }
        | IntegerRange(expr lower, expr upper)  -- {0, …, J}: the integers
                                              -- from lower to upper inclusive
        | Points(expr* members, setexpr? superset)
                                              -- {0, 1}; {0, θ} ⊂ ℝ: numerical
                                              -- members in authored order
        | Functions(setexpr domain, setexpr codomain)
                                              -- I_J → ℝ₊: the functions from
                                              -- an index set to an entry set

cond  = Rel(expr left, relop op, expr right)
      | Between(expr lower, relop lo, expr middle, relop hi, expr upper)
                                              -- a two-sided bound, 0 <= c_p <= w_d
relop = Lt | Le | Eq | Ge | Gt

-- The typing entries of a methods file (methods as types, 4 November 2026):
-- a method and a grid are classifier components of an operator's signature,
-- each assigned by one typing entry whose subject is the path of the
-- component; the handler is a binding beside the term, no classifier. The
-- word with its keyword arguments is the core's `word` (dynsym_new.asdl).

subject    += Path(segment* segments)         -- policy.evaluate[V[<]].method
segment     = Segment(identifier name, selector* selectors)
                                              -- evaluate[V], evaluate[D_{k}V[<]]
selector   += Term(expr at)                   -- a selector that is a term, written
                                              -- in the subject of a typing entry alone
typer      += Handler(subject subject, string program)
                                              -- policy.handler : "cons-port:egm"
classifier += Method(word m)                  -- policy.method : !egm(tol=tol_v)
classifier += Grid(grid g)                    -- policy.grid : !Cartesian(a=(a_min, a_max, n_a)),
                                              -- !Points(nodes=P) or !Fibred(base=…, fibre=…)

-- The grid of a place is one outer grid word (AMD-MT-003 build contract §2).
-- Each constructor carries the predicate words written after `require`, by
-- their names, `require=!UniformCartesian` or `require=(!Empty, !Cartesian)`;
-- the words are predicates on the resulting grid, not components, and
-- `stage/grids.py` judges them. The constructor of `!Points` is named
-- PointGrid, since the set expression Points of a brace set holds that name.
-- TensorUnion, Image and Smolyak are reserved by name and not built.
grid    = Cartesian(factor* factors, identifier* require)
                                              -- at most one factor per coordinate, keyed
                                              -- by its name, !Cartesian(a=(a_min, a_max,
                                              -- n_a))
        | PointGrid(identifier? nodes, identifier* require)
                                              -- !Points(nodes=P), the finite support of
                                              -- the declared points P; !Points alone is
                                              -- the empty grid
        | Fibred(grid base, grid fibre, identifier* require)
                                              -- !Fibred(base=!Points(nodes=B),
                                              -- fibre=!Cartesian(c=(Γ_c, n_c))), each base
                                              -- state paired with its feasible controls
factor  = Spaced(identifier coordinate, argument lower, argument upper,
                 argument count, word? spacing)
                                              -- a=(a_min, a_max, n_a, !expmult(nest=grid_phi))
        | Listed(identifier coordinate, identifier nodes)
                                              -- m=M_nodes, a declared node set, or ν=E_ν,
                                              -- the expectation operator whose quadrature
                                              -- nodes the coordinate takes
        | Feasible(identifier coordinate, identifier set, argument count)
                                              -- c=(Γ_c, n_c), a control on its feasible set
