// stage.lark — the working concrete grammar of Bellman-SYM
// (canonical here; the spec folder keeps the EconForge-facing
// baseline and step ladder). Self-contained: duplicates the
// expression ladder rather than importing dynsym's, following the
// modfile precedent.
//
// Typing spelling per typing-spelling-0.3 (26 Aug 2026 rulings):
// the colon types; a type is an unordered @-joined conjunction of
// components, each a set expression or a !-marked vocabulary word
// (one token class — which words are admitted, and what each may
// type, is the vocabulary's ruling, checked after parsing); the
// tilde assigns a law on its own line; := defines, and <- is a second
// spelling of :=.
//
// The typing entries of a methods file (4 November 2026): a typing entry
// types a component of an operator by the path of the component,
// `policy.method : !egm(tol=tol_v)`, `evaluate[V[<]].grid : !Cartesian(…)`,
// written inside a header bracket, in a group that `|` opens, or at file
// level; a handler binding names, by a quoted string, the program that
// realizes the operator, `policy.handler : "cons-port:egm"`; a !-word
// carries keyword arguments in parentheses.

?start: file
file: _NL? file_item (_NL file_item)* _NL?
?file_item: metadata | assignment | function_definition | declaration | file_binding | law | block

// space-defining assignment: Y := R, D := {work, retire}, X := R+,
// Xa := [0, ā], H := {i : ℤ | i >= 0, i <= 1}. An interval body lowers to
// the same Interval term as an interval written after a typing colon, and a
// comprehension body to the Comprehension of a correspondence body. The
// open-open interval body is unreachable here ((a, b) reads as a tuple), as
// in `function_body`; write an open interval after the typing colon where it
// is used. A union or a difference of sets, `(0,1) \/ (1, inf)`, is no value
// of a named set: it is written after a typing colon, in the set of a
// parameter, of a derived parameter or of a setting (rule `setexpr`).
assignment: plain_name _ASSIGN assigned_value STMT_META?
?assigned_value: RPLUS -> reserved_set_name
      | BBSET -> reserved_set_name
      | brace_set
      | integer_range
      | comprehension
      | assignment_product
      | assignment_functions
      | "(" formula "," formula "]" -> interval_open_closed
      | "[" formula "," formula ")" -> interval_closed_open
      | "[" formula "," formula "]" -> interval_closed_closed
      | formula
      | conditional
// A definition by cases, `a : ℝ_{+∞} := if Γ < R then 1/(R - Γ) else inf`:
// the right side of a derived parameter's definition is the first branch
// where the test holds and the second otherwise, and the branch not chosen
// is not evaluated. A branch is a formula or a further conditional, so that
// three cases are written `if a < 0 then -1 else if a = 0 then 0 else 1`.
// The form stands as the whole right side after `:=`, in a definition
// without a declared set (rule `assigned_value`) and in one that declares a
// set (rule `declared_value`), and inside no formula. `if`, `then` and
// `else` are words of the language: the lowering refuses each of them
// wherever the parser reads it as a name (AMD-GRAM-006).
conditional: _IF condition _THEN _branch _ELSE _branch
_branch: formula | conditional
?condition: formula RELOP formula -> comprehension_condition
    | formula "=" formula -> comprehension_equality
// A named fixed product uses the existing set term. Keeping its first
// factor outside the interval rule preserves (a, b) as an expression tuple.
// A set of functions after `:=`, `Q := L_J → ℝ₊`, names its domain first.
assignment_product: named_set "×" set_product_level -> set_product
                  | brace_set "×" set_product_level -> set_product
                  | integer_range "×" set_product_level -> set_product
assignment_functions: named_set "→" setexpr -> set_functions
                    | brace_set "→" setexpr -> set_functions
                    | integer_range "→" setexpr -> set_functions
                    | assignment_product "→" setexpr -> set_functions

// dyno's metadata line; @stage: <name> designates a stage file
metadata: _AT NAME ":" METADATA_SCALAR

// declarations: subject : type [<- value]
// A type may hold several sets, with @ between them, and the declared
// name lies in each of them: γ : ℝ₊ @ (-inf, 2) means γ : { g ∈ ℝ₊ : g < 2 }
// (AMD-GRAM-004). A tuple subject may carry its
// types per coordinate, so the tuple-level typing is optional.
// The colon binds to the smallest complete object on its left:
// w, c : T types c alone; (w, c) : T types the tuple as one
// object, and tuples nest wherever a name may stand. A subject with a
// dot, `cntn_to_dcsn.evaluate.grid : !Cartesian(…)`, is a typing entry
// at file level, routed by its path to the operator it names.
declaration: subject_path typing declared_value? STMT_META?
    | tuple_subject typing? declared_value? STMT_META?
// a handler binding at file level, `dcsn_to_cntn.handler : "cons-port:transition"`
file_binding: binding STMT_META?
RELOP: "<=" | ">=" | "≤" | "≥" | "<" | ">"
?single_subject: plain_name | bracketed_name
tuple_subject: "(" coordinate ("," coordinate)* ")"
coordinate: bracketed_name typing? | plain_name typing? | tuple_subject typing?
// the value a declaration carries, `q : (0,1) := (β*R)^(1/ρ)/R`: a formula,
// or a definition by cases, `q : (0, 3) := if β < R then 1 else 2`
declared_value: _ASSIGN (formula | conditional)
_ASSIGN.2: "<-" | ":="

// the subject of a declaration, of a law, of a bare side and of a typing
// entry: a path of segments joined by dots, each a name with selectors in
// brackets. A name alone or with its perch mark, `V[>]`, names a field and
// parses as it did before paths were admitted; a dotted path names the
// component of an operator, `policy.evaluate.method`, and a selector of a
// segment names the object an Evaluation stores, by its name or by its
// term, `evaluate[V].method`, `evaluate[D_{k}V[<]].grid`.
?subject_path: subject_segment | subject_segment ("." subject_segment)+ -> path
?subject_segment: plain_name | plain_name ("[" selector "]")+ -> bracketed_name
?selector: PMARK | plain_name | NUMBER | bracketed_name | operator_call

// the law statement: y ~ N(μ, σ); a joint law takes a tuple subject, whose
// coordinates are names alone: the lowering refuses a type written inside
// its parentheses
law: subject_path "~" formula STMT_META?
   | tuple_subject "~" formula STMT_META?

// a function definition: 𝑢(c : ℝ₊₊) := c^(1-γ)/(1-γ); every binder
// carries its type. A set-expression body makes it a correspondence
// definition instead: Γ(x : ℝ₊) := (0, x]. The open-open interval
// body is unreachable here ((a, b) reads as a tuple); spell such a
// correspondence by comprehension, Γ(x : ℝ₊₊) := {c : ℝ₊₊ | c < x},
// or by a named set. A comprehension binds one name typed by one set
// and relates expressions after the bar; it lowers to the abstract
// Comprehension(subject bound, setexpr base, cond* conds).
function_definition: plain_name "(" function_parameter ("," function_parameter)* ")" _ASSIGN function_body STMT_META?
?function_body: formula
    | correspondence_product
    | brace_set
    | integer_range
    | comprehension
    | "(" formula "," formula "]" -> interval_open_closed
    | "[" formula "," formula ")" -> interval_closed_open
    | "[" formula "," formula "]" -> interval_closed_closed
// A product body requires ×, so (a, b) alone remains an expression tuple.
correspondence_product: correspondence_factor "×" set_product_level -> set_product
?correspondence_factor: named_set
    | brace_set
    | integer_range
    | "(" formula "," formula "]" -> interval_open_closed
    | "[" formula "," formula ")" -> interval_closed_open
    | "[" formula "," formula "]" -> interval_closed_closed
    | tuple -> open_interval_factor
function_parameter: plain_name typing
comprehension: "{" plain_name typing "|" comprehension_condition ("," comprehension_condition)* "}"
comprehension_condition: formula RELOP formula
    | formula "=" formula -> comprehension_equality

// blocks: parsed header + body
block: header _body
// the header holds the block's own entries, then the groups that `|`
// opens, each holding typing entries of the block's operators and their
// handler bindings; `]` closes the whole annotation, and every entry of
// every group is an entry of the one annotation
header: "[" header_entry ("," header_entry)* ("|" _group)* "]"
_group: group_entry ("," group_entry)*
?group_entry: typing_entry | binding
?header_entry: key_value | word_tag | signature | bare_tag | quoted_tag | typing_entry | binding
key_value: plain_name "=" header_value
?header_value: plain_name | NUMBER
// the ! mark spells vocabulary words; in a header it is the
// statement- and block-level type register (!node; a method is written
// as a typing entry)
word_tag: TAGBANG
// a bare tag, or a tag with keyword arguments, `capital(order=2)`
bare_tag: plain_name arguments?
// a quoted string in a header bracket is a tag (dyno tip 312e8ea)
quoted_tag: STAGE_STRING
// a typing entry types a component of an operator of the block by its
// path: the block's own, `policy.method : !egm` or the relative `method :
// !egm`; an operator's inside the block, `evaluate.method : !Linear`,
// `E_ψ_ξ.method : !gauss_hermite(n_ψ=n_ψ_nodes)`; a grid,
// `evaluate[V[<]].grid : !Cartesian(k=(k_min, k_max, n_k))`
typing_entry: subject_path typing
// the handler binding of a place: the program that realizes the
// operator, named by a quoted string, `policy.handler : "cons-port:egm"`
binding: subject_path _COLON STAGE_STRING
signature: side "->" side
// a side is parenthesized in general; a single coordinate may stand
// bare (V : !dcsn -> …)
side: "(" [coordinate ("," coordinate)*] ")" typing? | bare_side
bare_side: subject_path typing?

_body: "{" _NL? block_item (_NL block_item)* _NL? "}"
?block_item: block | function_definition | statement | block_declaration
// the ⟂ clause states complementary slackness between the residual of a
// line and its bound, or between a declared multiplier and its bound; the
// bound is held in the rule and checked by no construction (AMD-SG-035 §5).
// A statement's clause carries one bound or two, `⟂ lb <= x <= ub`; a
// declaration's one. Glyph fixed as ⟂ (U+27C2); ⊥ (U+22A5) is not admitted.
statement: (equality | inequality) slackness_clause? STMT_META?
// a declaration inside a block body, `μ[>] : ℝ₊ ⟂ a >= 0`; the typing reads the mark
block_declaration: single_subject typing slackness_clause STMT_META?
slackness_clause: _PERP formula RELOP formula (RELOP formula)?
_PERP: "⟂"

// the typing: one colon, then an unordered @-joined conjunction
typing: _COLON type
type: component (_AT component)*
?component: word_type | setexpr
// a !-marked word with its keyword arguments, `!egm(tol=tol_v)`; a role
// or a perch word takes none, which the lowering checks
word_type: TAGBANG arguments?
// keyword arguments, `(n_ψ=n_ψ_nodes, n_ξ=n_ξ_nodes)`: a value is a name,
// a number, a quoted string, a tuple of values, or a !-word with its own
// arguments, `(a_min, a_max, n_a, !expmult(nest=grid_phi))`
arguments: "(" keyword ("," keyword)* ")"
keyword: plain_name "=" argument
?argument: plain_name -> argument_name
    | NUMBER -> argument_number
    | STAGE_STRING -> argument_string
    | "(" argument ("," argument)+ ")" -> argument_tuple
    | word_type -> argument_word

// a set expression after a typing colon. A union, `A \/ B`, and a
// difference, `A \ B`, of sets of numbers stand at one level and are read
// from left to right: `A \ B \/ C` is the union of `A \ B` with C. The
// product × binds before the two signs and the arrow → after them, so
// that `I → A \/ B` is the functions from I into the union. Parentheses
// do not group sets. `∪` is a second spelling of `\/`, and `∖` (U+2216) of
// `\`. The two signs are read in the set of a parameter, of a derived
// parameter and of a setting; in every other set the declaration pass
// refuses them (AMD-GRAM-005).
?setexpr: set_union_level
    | set_union_level "→" setexpr   -> set_functions
?set_union_level: set_product_level
    | set_union_level _UNION set_product_level      -> set_union
    | set_union_level _DIFFERENCE set_product_level -> set_difference
?set_product_level: set_atom
    | set_product_level "×" set_atom  -> set_product
?set_atom: named_set
    | interval
    | brace_set
    | integer_range
named_set: BBSET | RPLUS | plain_name
// reserved set glyphs — terminals, like Mathematica's Reals; not
// assignable, no definition line needed. Extended reals name the
// adjoined endpoint in a brace subscript (the D_{c}/E_{y} idiom):
// ℝ_{-∞} = [-∞, ∞); ℝ_{+∞} = (-∞, ∞]; ℝ_{±∞} = [-∞, ∞], with ℝ̄
// its standard short alias. (Subscript forms ℝ̄₊/ℝ̄₋ were rejected:
// they read as sign restrictions beside ℝ₊.)
BBSET.3: /ℝ_\{[+\-±]∞\}|ℝ̄|ℝ₊{0,2}|ℕ|ℤ/
interval: "(" formula "," formula ")"   -> interval_open_open
    | "(" formula "," formula "]"       -> interval_open_closed
    | "[" formula "," formula ")"       -> interval_closed_open
    | "[" formula "," formula "]"       -> interval_closed_closed
// one brace list of formulas: the lowering reads names alone as a finite
// set of labels, numbers alone as a set of numbers, and any list followed
// by the set its members lie in, `{0, θ} ⊂ ℝ`, as a set of numbers whose
// members are the formulas; `{0, …, J}` is the integer range from the
// first bound to the second, inclusive
brace_set: "{" formula ("," formula)* "}" ("⊂" set_atom)?
integer_range: "{" formula "," _ELLIPSIS "," formula "}"
_ELLIPSIS: "…" | "..."

// dynspec's expression ladder (duplicated) + Operator braces + perch marks
equality: formula "=" formula
// an inequality statement, `c[>] <= 𝑑𝑢𝑖𝑛𝑣(dV[>])`: a valid spelling of an
// occasionally binding constraint (ruling D20, 9 Sep 2026)
inequality: formula RELOP formula
?formula: sum
?sum: product
    | sum "+" product  -> add
    | sum "-" product  -> sub
    | "-" product      -> neg
?product: molecule
    | product "*" molecule -> mul
    | product "/" molecule -> div
?molecule: atom
    | atom _POW atom   -> pow
_POW: "^" | "**"
?atom: NUMBER          -> number
    | INFTY            -> infinity
    | tuple_selection
    | tuple
    | bracketed_name
    | operator_call
    | call
    | plain_name            -> constant
    | "(" formula ")"

// one tuple rule for the whole grammar: law parameters and formula
// position alike; a tuple is a finite family, selection evaluates it
tuple: "(" formula ("," formula)+ ")"
tuple_selection: tuple "[" formula "]"
// every bracket is selection along an axis of the head: dates (dyno),
// the perch marks < ~ >, a name key, or a 1-based position. In a stage
// file ~ marks the decision perch; a field at that perch is written
// bare, so x[~] lowers to the same term as x (AAS, 6 Sep 2026). It is
// not dyno's steady-state marker k[~], which a stage has no use for.
bracketed_name: plain_name ("[" bracket_index "]")+
?bracket_index: PMARK | plain_name | NUMBER
PMARK: "<" | ">" | "~"
// an operator subscript is a binder name, or a binder constrained to
// a feasible set — argmax_{cp : Γ(w)}; the colon types the binder,
// as in every binder, and lowers to the In binder. One meaning per
// symbol (AAS, 9 Sep 2026): ⟂ is complementarity only and is not
// admitted here.
// a one-argument operator call also names its argument without parentheses
// where the argument is a plain name or a bracketed name with a perch mark:
// `D_{a}V[>]`, `D_{m}V` and `D_{w}V[<]` lower to the term `D_{a}(V[>])`
// lowers to, through the same aliases `bracketed_name` and `constant`
// (AMD-MB-001 §4.2, decision D2)
operator_call: plain_name "{" operator_subscript ("," operator_subscript)* "}" "(" formula ("," formula)* ")"
    | plain_name "{" operator_subscript ("," operator_subscript)* "}" operator_field
?operator_field: bracketed_name
    | plain_name -> constant
?operator_subscript: plain_name
    | plain_name _COLON formula -> member_subscript
?call: plain_name "(" formula ("," formula)* ")" -> call

!plain_name: NAME -> name

// terminals
// the three words of a conditional, each a whole word
_IF.5: /if(?!\w)/
_THEN.5: /then(?!\w)/
_ELSE.5: /else(?!\w)/
_AT: "@"
// the two signs of a set expression, each with its second spelling
_UNION: "\\/" | "∪"
_DIFFERENCE: "\\" | "∖"
_COLON: ":"
// the glyph twin of the name `inf`: lowers to the same constant
INFTY: "∞"
TAGBANG: "!" NAME
STAGE_STRING: /"[^"\r\n]*"|'[^'\r\n]*'/
RPLUS.3: /R_\{\+{1,2}\}|R\+{1,2}/
METADATA_SCALAR: /[^\s#\r\n][^\r\n#]*/
// inside the brackets a double-quoted explanation may contain `]` and `,`
STMT_META.3: /[ \t]*::[ \t]*(?:\[(?:[^\]"\r\n]|"[^"\r\n]*")*\]|"[^"\r\n]*"|[^\r\n#{]+)/
_NL: NEWLINE+
UNICODE_LETTER: /[^\W\d_\$ℝℕℤ]/
NAME: UNICODE_LETTER ("_"|UNICODE_LETTER|DIGIT)*

%import common.DIGIT
%import common.NUMBER
%import common.NEWLINE
%import common.WS_INLINE

SOL_COMMENT.10: /^[ \t]*#[^\r\n]*(\r?\n)*/m
EOL_COMMENT.9: /(?<!^)[ \t]*#[^\r\n]*/m
%ignore SOL_COMMENT
%ignore EOL_COMMENT
%ignore WS_INLINE
