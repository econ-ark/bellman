          }
        },
        "settings": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/mapping"
            }
          ]
        }
      },
      "required": [
        "calibration",
        "methods",
        "settings"
      ],
      "additionalProperties": false
