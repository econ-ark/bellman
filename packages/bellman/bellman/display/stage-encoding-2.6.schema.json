            "type": "string"
          }
        },
        "wires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wire"
          }
        },
        "boxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/box"
          }
        }
      },
      "required": [
        "inputs",
        "outputs",
        "wires",
        "boxes"
      ],
      "additionalProperties": false
    },
    "wire": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "field",
            "function",
            "measure"
          ]
        },
        "perch": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "$ref": "#/$defs/term"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "identity",
        "kind",
        "perch",
        "role",
        "domain",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "box": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "address": {
          "type": "string"
        },
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/box"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pieceMethod"
          }
        }
      },
      "required": [
        "name",
        "kind",
        "label",
        "in",
        "out"
      ],
      "additionalProperties": false
    },
    "setting": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setting"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/json"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/settings"
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/setting"
      }
    },
    "method": {
      "description": "The components typed at one place: the method word and the grid as terms, null where not typed, and the handler's program (specification 0.7, the ruling On structure).",
      "type": "object",
      "properties": {
        "method": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/term"
            }
          ]
        },
        "grid": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/term"
            }
          ]
        },
        "handler": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "grid",
        "handler"
      ],
      "additionalProperties": false
    },
    "pieceMethod": {
      "description": "The components typed at one place within a box, with the place's address.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/term"
            }
          ]
        },
        "grid": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/term"
            }
