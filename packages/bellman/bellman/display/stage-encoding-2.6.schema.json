{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econ-ark.org/bellman-sym/stage-encoding/2.6",
  "title": "An elaborated Bellman-SYM stage",
  "description": "The stage encoding: the JSON document `stage.encoding()` writes for one version of a Bellman-SYM stage. Each node of its derived answers carries a kind, spelled `<namespace>.<Kind>` in one of the five namespaces `x-namespaces` lists, with the fields `x-constructors` gives it. A namespace is a name of this schema and names no module of the package that writes the document: the package holds one table from its classes to these kinds, so that a class may be moved or renamed while a document already written stays as written.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "https://econ-ark.org/bellman-sym/stage-encoding/2.6"
    },
    "version": {
      "enum": [
        "symbolic",
        "calibrated",
        "methodized",
        "specified",
        "methods",
        "settings",
        "calibration, settings",
        "methods, settings"
      ]
    },
    "name": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/mapping"
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "initial_diagrams": {
      "$ref": "#/$defs/directions"
    },
    "builders": {
      "$ref": "#/$defs/directions"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    },
    "package_version": {
      "type": "string"
    },
    "derived": {
      "$ref": "#/$defs/derived"
    }
  },
  "required": [
    "schema",
    "version",
    "name",
    "metadata",
    "definitions",
    "initial_diagrams",
    "builders",
    "bindings",
    "provenance",
    "obligations",
    "diagnostics",
    "package_version",
    "derived"
  ],
  "additionalProperties": false,
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "term": {
      "description": "The existing syntax.lower.to_json representation, including null for an undeclared set.",
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        {
          "type": "object",
          "required": [
            "__class__"
          ],
          "properties": {
            "__class__": {
              "type": "string"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        }
      ]
    },
    "definition": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "set",
            "distribution",
            "parameter",
            "derived parameter",
            "setting",
            "function",
            "function alias",
            "correspondence",
            "law of motion",
            "value aggregator",
            "line",
            "multiplier",
            "typing entry"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/term"
              }
            ],
            "items": false,
            "minItems": 2
          }
        },
        "equations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "term": {
                "$ref": "#/$defs/term"
              }
            },
            "required": [
              "address",
              "term"
            ],
            "additionalProperties": false
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "address": {
          "type": "string"
        },
        "ordinal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "on a line, its position among the items of its block's body, from 1, the branches of a branching block counted in turn; null for every other kind"
        },
        "describes": {
          "type": [
            "string",
            "null"
          ]
        },
        "categories": {
          "type": "object",
          "description": "on a set marked `!categories`, its category map: the identifier written after the marker, or null, and the pairs of a code and its category's name in increasing code order; absent on every other definition",
          "properties": {
            "identifier": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "codes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ],
                "items": false,
                "minItems": 2
              }
            }
          },
          "required": [
            "identifier",
            "codes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "identity",
        "kind",
        "coordinates",
        "equations",
        "tags",
        "address",
        "ordinal",
        "describes"
      ],
      "additionalProperties": false
    },
    "directions": {
      "type": "object",
      "properties": {
        "backward": {
          "oneOf": [
            {
              "$ref": "#/$defs/graph"
            },
            {
              "$ref": "#/$defs/refusal"
            }
          ]
        },
        "forward": {
          "oneOf": [
