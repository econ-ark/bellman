              "$ref": "#/$defs/refusal"
            }
          ]
        }
      },
      "required": [
        "backward",
        "forward"
      ],
      "additionalProperties": false
    },
    "refusal": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "message"
      ],
      "additionalProperties": false
    },
    "graph": {
