@methods: cons
# The methods of the consumption stage as an addition to
# applications/portfolio-choice/declaration/stages/cons/cons.bl: the
# endogenous grid method on the policy builder, with its grid of savings and
# the function egm of cons-port as its handler; the two candidate lines of
# the block policy, the inverted Euler equation with its Kuhn-Tucker clause
# and the inverted law of motion, and its identification line c = c[>]; one
# linear representation of the decision value and of its stated derivative
# on the grid of resources, one entry at the Evaluation of cntn_to_dcsn that
# types every object the Evaluation stores (D4), with the function
# _make_interp of cons-port as its handler; the deterministic arrival
# builder; and the handler of the forward decision builder, which no method
# word accompanies. The three lines of the block policy are written as a
# solution method's lines are written: with the solution method !egm typed
# on the block, they stand in place of the declared maximization at the
# operative level, and stage.declared keeps the maximization of cons.bl (D8;
# rule 5). No entry is written for dcsn_to_arvl, since an entry there would
# bind nothing (sheet §5). The block policy carries no signature, since a
# methods-file block that adds no coordinate carries none (sheet §1). The
# selections that add no line are file-level lines routed by their paths
# (rule 7), since an empty body is refused.
# Each grid is its own typing entry at its place, one factor per coordinate
# keyed by the coordinate's name (writer's sheet §7; D5). Every setting a
# grid reads is declared above the blocks and lines with its set, a bound as
# a point of the set its coordinate is declared on, a count in ℕ (sheet §6).

𝑑𝑢𝑖𝑛𝑣(x : ℝ₊₊) := x^(-1/ρ)

n_a : ℕ        :: ["number of points of the savings grid"]
a_min : Xa     :: ["lower bound of the savings grid"]
a_max : Xa     :: ["upper bound of the savings grid"]
n_m : ℕ        :: ["number of points of the grid of resources"]
m_min : Xm     :: ["lower bound of the grid of resources"]
m_max : Xm     :: ["upper bound of the grid of resources"]

[id=policy, method : !egm | grid : !Cartesian(a=(a_min, a_max, n_a)) | handler : "cons-port:egm"] {
    c[>]   <= 𝑑𝑢𝑖𝑛𝑣(D_{a}V[>]) ⟂ a >= 0    :: [id=InvEuler]
    m_d[>] = a + c[>]                        :: [id=grid]
    c      = c[>]                            :: [id=identification]
}

cntn_to_dcsn.evaluate.method : !Linear
cntn_to_dcsn.evaluate.grid : !Cartesian(m_d=(m_min, m_max, n_m))
cntn_to_dcsn.evaluate.handler : "cons-port:_make_interp"
arvl_to_dcsn.method : !deterministic
dcsn_to_cntn.handler : "cons-port:transition_fwd"
