@stage: survival

Plan := {DB, DC}

p_s : [0,1]                                      :: ["probability of surviving into the age of the period, Section 5"]

s : {survive, die}
s ~ Categorical((p_s, 1 - p_s))                  :: ["surviving or dying, with probabilities in the order of the labels"]

[id=arvl_to_dcsn, (a_s : ℝ₊, y_s : ℝ₊, adc_s : ℝ₊, h_s : ℝ₊, m_s : ℝ₊, P_s : ℝ₊₊, ξ_s : ℝ, α_s : (0,1), β_s : (0,1), plan_s : Plan, π_s : [0,1]) : !arvl -> (a_d : ℝ₊, y_d : ℝ₊, adc_d : ℝ₊, h_d : ℝ₊, m_d : ℝ₊, P_d : ℝ₊₊, ξ_d : ℝ, α_d : (0,1), β_d : (0,1), plan_d : Plan, π_d : [0,1]) : !dcsn] {
    a_d    = a_s
    y_d    = y_s
    adc_d  = adc_s
    h_d    = h_s
    m_d    = m_s
    P_d    = P_s
    ξ_d    = ξ_s
    α_d    = α_s
    β_d    = β_s
    plan_d = plan_s
    π_d    = π_s
}

[id=dcsn_to_cntn, (a_d, y_d, adc_d, h_d, m_d, P_d, ξ_d, α_d, β_d, plan_d, π_d, s) : !dcsn -> ()] {
    [label=survive, () -> (a_sv : ℝ₊, y_sv : ℝ₊, adc_sv : ℝ₊, h_sv : ℝ₊, m_sv : ℝ₊, P_sv : ℝ₊₊, ξ_sv : ℝ, α_sv : (0,1), β_sv : (0,1), plan_sv : Plan, π_sv : [0,1]) : !cntn] {
        a_sv = a_d
        y_sv = y_d
        adc_sv = adc_d
        h_sv = h_d
        m_sv = m_d
        P_sv = P_d
        ξ_sv = ξ_d
        α_sv = α_d
        β_sv = β_d
        plan_sv = plan_d
        π_sv = π_d
    }
    [label=die, () -> (a_bq : ℝ₊, adc_bq : ℝ₊, h_bq : ℝ₊, m_bq : ℝ₊, P_bq : ℝ₊₊) : !cntn] {
        a_bq = a_d
        adc_bq = adc_d
        h_bq = h_d
        m_bq = m_d
        P_bq = P_d
    }
}

[id=cntn_to_dcsn, (V_sv[>] : [-inf, inf) @ !vlu, V_bq[>] : ℝ @ !vlu) : !cntn -> (V : [-inf, inf) @ !vlu) : !dcsn] {
    V        = E_{s}((V_sv[>], V_bq[>])[s])                   :: [id=value]
    D_{a_d}V = E_{s}((D_{a_sv}V_sv[>], D_{a_bq}V_bq[>])[s])   :: [id=marginal_liquid]
    D_{h_d}V = E_{s}((D_{h_sv}V_sv[>], D_{h_bq}V_bq[>])[s])   :: [id=marginal_housing]
    D_{m_d}V = E_{s}((D_{m_sv}V_sv[>], D_{m_bq}V_bq[>])[s])   :: [id=marginal_mortgage]
}

[id=dcsn_to_arvl, (V) : !dcsn -> (V[<] : [-inf, inf) @ !vlu) : !arvl] {
    V[<] = V                                     :: [id=value]
}
